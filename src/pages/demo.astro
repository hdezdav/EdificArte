---
import Layout from '../layouts/Layout.astro';
import AiAgent from '../components/AiAgent.astro';
import UnifiedSearchBar from '../components/UnifiedSearchBar.astro';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale as Locale) || DEFAULT_LOCALE;

const runtimeEnv = Astro.locals?.runtime?.env;
const mapboxToken =
  runtimeEnv?.MAPBOX_TOKEN || import.meta.env.MAPBOX_TOKEN || '';
---

<Layout title="EdificARTE - Demo Mode" fullScreen={true} locale={locale}>
  <!-- Fake GPS: Hotel Virreyes coordinates - MUST run FIRST -->
  <script is:inline define:vars={{ mapboxToken }}>
    window.__EDIFICARTE_TOKEN__ = mapboxToken;
    window.__TURIMAP_TOKEN__ = mapboxToken;
    window.__DEMO_MODE__ = true;
    window.__DEMO_FAST_LOAD__ = true;

    // Force fake GPS IMMEDIATELY - block any real geolocation
    (function () {
      var DEMO_LAT = 19.4262;
      var DEMO_LNG = -99.1679;

      var pos = {
        coords: {
          latitude: DEMO_LAT,
          longitude: DEMO_LNG,
          accuracy: 5,
          altitude: null,
          altitudeAccuracy: null,
          heading: null,
          speed: null
        },
        timestamp: Date.now()
      };

      // Store demo position globally
      window.__DEMO_POSITION__ = pos;

      // Override navigator.geolocation immediately and permanently
      var fakeGeo = {
        watchPosition: function (success, error, options) {
          console.log('[DEMO] Fake GPS watchPosition called');
          setTimeout(function() { success(pos); }, 0);
          return 1;
        },
        getCurrentPosition: function (success, error, options) {
          console.log('[DEMO] Fake GPS getCurrentPosition called');
          setTimeout(function() { success(pos); }, 0);
        },
        clearWatch: function () {
          console.log('[DEMO] Fake GPS clearWatch called');
        }
      };

      // Force override with non-configurable property
      Object.defineProperty(navigator, 'geolocation', {
        get: function () { return fakeGeo; },
        configurable: false,
        enumerable: true
      });

      console.log('[DEMO] Fake GPS activated at', DEMO_LAT, DEMO_LNG);
    })();
  </script>

  <!-- Demo Overlay Controls -->
  <div
    id="demo-controls"
    class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center bg-black/20 backdrop-blur-[3px] transition-opacity duration-500"
  >
    <!-- Demo Card -->
    <div
      id="demo-card"
      class="liquid-glass pointer-events-auto relative mx-4 w-full max-w-md rounded-3xl p-5 shadow-2xl sm:p-6"
    >
      <!-- Progress Indicator -->
      <div class="mb-3 flex gap-1.5 sm:mb-4">
        <div class="progress-dot h-2 flex-1 rounded-full bg-accent-600 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
      </div>

      <!-- Content -->
      <div id="demo-content">
        <div class="mb-2 flex items-center gap-2">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-600 text-xl transition-transform duration-300 sm:h-10 sm:w-10"
            id="demo-emoji"
          >
            🌍
          </span>
          <h2
            class="text-lg font-bold text-slate-800 dark:text-white sm:text-xl"
            id="demo-title"
          >
            Bienvenido a EdificARTE
          </h2>
        </div>
        <p
          class="mb-5 text-[12px] leading-relaxed text-slate-600 dark:text-slate-300 sm:mb-6 sm:text-[13px]"
          id="demo-description"
        >
          Descubre el patrimonio cultural con guías de IA, experiencias inmersivas y recorridos de audio multilingües.
        </p>
      </div>

      <!-- Actions -->
      <div class="flex gap-2.5 sm:gap-3">
        <button
          id="btn-demo-skip"
          class="flex-1 rounded-xl border border-slate-200 px-3 py-2 text-[11px] font-semibold text-slate-600 transition-all hover:bg-slate-100 active:scale-95 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 sm:px-4 sm:py-2.5 sm:text-[12px]"
        >
          Omitir
        </button>
        <button
          id="btn-demo-next"
          class="flex-1 rounded-xl bg-accent-600 px-3 py-2 text-[11px] font-semibold text-white shadow-lg shadow-accent-600/20 transition-all hover:bg-accent-700 active:scale-95 sm:px-4 sm:py-2.5 sm:text-[12px]"
        >
          Siguiente
        </button>
      </div>
    </div>
  </div>

  <!-- Demo Spotlight -->
  <div
    id="demo-spotlight"
    class="pointer-events-none fixed z-40 hidden rounded-2xl border-4 border-accent-500 shadow-[0_0_0_9999px_rgba(0,0,0,0.5)] transition-all duration-700 ease-in-out"
  ></div>

  <!-- Demo Annotations (floating hints) -->
  <div
    id="demo-annotation"
    class="liquid-glass pointer-events-none fixed z-40 hidden max-w-[85vw] rounded-2xl px-3.5 py-2.5 shadow-xl transition-all duration-500 sm:max-w-xs sm:px-4 sm:py-3"
  >
    <p class="text-[10px] font-semibold text-slate-700 dark:text-slate-200 sm:text-[11px]" id="demo-annotation-text"></p>
  </div>

  <!-- Embedded Map Page -->
  <div class="h-screen w-full">
    <!-- Floating Search Bar -->
    <div
      class="unified-search-map-layer pointer-events-none absolute left-0 right-0 top-0 z-30 flex flex-col items-center gap-2 px-4 pt-2"
    >
      <UnifiedSearchBar
        inputId="search-input"
        clearId="map-search-clear"
        suggestionsId="search-suggestions"
        placeholder="Buscar lugares, ciudades y monumentos..."
        ariaLabel="Buscar lugares"
        i18nPlaceholder="mapa.search_placeholder"
        outerClass="pointer-events-auto"
      />

      <!-- Filter Chips -->
      <div
        id="map-filter-chips"
        class="no-scrollbar pointer-events-auto relative z-10 -mx-4 flex w-full max-w-lg gap-2 overflow-x-auto scroll-smooth px-4 pb-3 pt-1 sm:flex-wrap sm:justify-center sm:overflow-x-visible"
      >
        <button
          data-filter="all"
          data-i18n="mapa.filters.all"
          class="filter-chip active flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          Todos
        </button>
        <button
          data-filter="museum"
          data-i18n="mapa.filters.museums"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          🏛️ Museos
        </button>
        <button
          data-filter="temple"
          data-i18n="mapa.filters.temples"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          ⛪ Templos
        </button>
        <button
          data-filter="park"
          data-i18n="mapa.filters.parks"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          🌳 Parques
        </button>
        <button
          data-filter="historic"
          data-i18n="mapa.filters.historic"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          🏰 Histórico
        </button>
      </div>
    </div>

    <!-- Floating Controls -->
    <div
      id="map-floating-controls"
      class="pointer-events-auto fixed right-3 z-30 flex flex-col items-end gap-2 transition-all duration-300 ease-in-out sm:right-4"
      style="bottom: calc(8.25rem + env(safe-area-inset-bottom, 0px));"
    >
      <button
        id="btn-locate"
        class="liquid-glass flex h-11 w-11 items-center justify-center rounded-full text-slate-700 shadow-lg transition-all active:scale-90 dark:text-slate-200"
        aria-label="Centrar ubicación"
      >
        <span class="material-symbols-outlined text-[20px]" id="locate-icon"
          >my_location</span
        >
      </button>
    </div>

    <!-- Fullscreen Map -->
    <div id="map" class="absolute inset-0 z-0 h-full w-full"></div>

    <!-- Bottom Sheet -->
    <div
      id="bottom-sheet"
      class="liquid-glass absolute left-3 right-3 z-20 mx-auto max-w-lg overflow-hidden rounded-3xl transition-all duration-300"
      style="bottom: calc(5.25rem + env(safe-area-inset-bottom, 0px));"
    >
      <div
        id="sheet-header"
        class="flex w-full cursor-pointer select-none flex-col items-center pb-2 pt-3"
      >
        <div
          class="mb-2 h-[5px] w-10 rounded-full bg-slate-300 dark:bg-slate-700"
        >
        </div>
        <div class="flex w-full items-center justify-between px-4">
          <h2
            class="flex items-center gap-1.5 text-[14px] font-bold text-slate-800 dark:text-white"
          >
            <span
              class="material-symbols-outlined text-[18px] text-accent-600 dark:text-accent-400"
              >explore</span
            >
            <span data-i18n="mapa.sheet.title">Lugares Cercanos</span>
          </h2>
          <span
            id="sheet-chevron"
            class="material-symbols-outlined text-slate-450 text-[20px] transition-transform duration-300 dark:text-slate-500"
            >keyboard_arrow_up</span
          >
        </div>
      </div>

      <div
        id="sheet-body"
        class="overflow-y-auto px-4 pb-5 transition-all duration-300 ease-in-out"
      >
        <div id="view-list">
          <div
            class="no-scrollbar flex flex-col gap-2"
            id="places-list-container"
          >
            <p
              class="py-6 text-center text-[12px] text-slate-400 dark:text-slate-500"
              data-i18n="mapa.sheet.empty_cta"
            >
              Cargando patrimonio cercano...
            </p>
          </div>
        </div>
        <div id="view-detail" class="hidden"></div>
      </div>
    </div>

    <!-- AI Agent -->
    <AiAgent />
  </div>
</Layout>

<script>
  // Import map script to initialize the embedded map
  import { mountMap } from '../scripts/mapa-app.ts';

  // CRITICAL: Wait for fake GPS to be fully active before mounting map
  function waitForFakeGPS() {
    if (window.__DEMO_POSITION__ && navigator.geolocation) {
      console.log('[DEMO] Fake GPS confirmed, mounting map');
      mountMap();
    } else {
      console.log('[DEMO] Waiting for fake GPS...');
      setTimeout(waitForFakeGPS, 50);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitForFakeGPS);
  } else {
    waitForFakeGPS();
  }
  document.addEventListener('astro:page-load', waitForFakeGPS);
</script>

<script>
  interface DemoStep {
    emoji: string;
    title: string;
    description: string;
    spotlightSelector?: string;
    annotation?: string;
    action?: () => void;
  }

  const steps: DemoStep[] = [
    {
      emoji: '🗺️',
      title: 'Explora el Patrimonio Cultural',
      description:
        'Visualiza sitios históricos y culturales de México con pines 3D interactivos. Puedes filtrar por categoría, rotar el mapa y descubrir el patrimonio en tiempo real.',
      action: () => {
        setTimeout(() => {
          const map = (window as any).__edificarteMap;
          if (map) {
            map.flyTo({
              center: [-99.1412, 19.4340],
              zoom: 15,
              pitch: 45,
              bearing: 0,
              duration: 2200,
            });
          }
        }, 200);
      },
    },
    {
      emoji: '🎧',
      title: 'Exposición Metalingua en El Rule',
      description:
        'El Centro Cultural El Rule alberga "Nombrar el Orgullo Neo" con más de 200 audios y transcripciones en lenguas originarias de México.',
      action: () => {
        setTimeout(() => {
          const map = (window as any).__edificarteMap;
          const monuments = (window as any).__edificarteMonuments || [];
          const elRule = monuments.find((m: any) => m.id === 'el-rule');

          if (map && elRule) {
            map.flyTo({
              center: [elRule.lng, elRule.lat],
              zoom: 18.5,
              pitch: 60,
              bearing: 45,
              duration: 2000,
            });

            setTimeout(() => {
              const event = new CustomEvent('open-monument-detail', {
                detail: { monument: elRule }
              });
              window.dispatchEvent(event);
              if ((window as any).handlePinClick) {
                (window as any).handlePinClick(elRule);
              }
            }, 2100);
          }
        }, 200);
      },
    },
    {
      emoji: '🥇',
      title: 'Coleccionable NFT Desbloqueado',
      description:
        'Al explorar el Centro Cultural El Rule, recibes una medalla digital representativa que premia el descubrimiento cultural.',
      action: () => {
        setTimeout(() => {
          const map = (window as any).__edificarteMap;
          const monuments = (window as any).__edificarteMonuments || [];
          const elRule = monuments.find((m: any) => m.id === 'el-rule');

          if (map && elRule) {
            map.easeTo({
              bearing: 135,
              pitch: 65,
              duration: 2500,
            });

            setTimeout(() => {
              const toast = document.createElement('div');
              toast.className =
                'fixed top-5 left-1/2 -translate-x-1/2 z-[999999] flex items-center gap-2.5 rounded-full border border-white/50 bg-white/95 px-3.5 py-2 shadow-[0_10px_30px_rgba(0,0,0,0.18)] backdrop-blur-xl transition-all duration-500 -translate-y-16 opacity-0 dark:border-slate-700/60 dark:bg-slate-900/95 text-slate-800 dark:text-white pointer-events-auto max-w-[92vw] sm:gap-3.5 sm:px-4 sm:py-2.5';
              toast.innerHTML = `
                <div class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-tr from-amber-400 to-yellow-300 p-0.5 shadow-md sm:h-10 sm:w-10">
                  <img src="https://coming-aqua-flyingfish.myfilebase.com/ipfs/QmSb45pdEwGTuJFivhHuaRwZZFX83nrx4Gki1o5cCXqDo1" alt="Medalla" class="h-full w-full rounded-full object-cover" />
                  <span class="absolute -bottom-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500 text-[9px] font-bold text-white shadow-sm">✓</span>
                </div>
                <div class="text-left min-w-0 pr-1.5 sm:pr-2">
                  <div class="flex items-center gap-1.5 leading-none mb-0.5">
                    <span class="text-[9px] font-extrabold uppercase tracking-widest text-slate-500 dark:text-slate-400 sm:text-[10px]">EdificARTE</span>
                    <span class="text-[8px] text-slate-400 sm:text-[9px]">• ahora</span>
                  </div>
                  <p class="truncate text-[11px] font-bold text-slate-900 dark:text-white leading-tight sm:text-[12px]">Medalla: Centro Cultural El Rule</p>
                  <p class="text-[9px] font-semibold text-emerald-600 dark:text-emerald-400 leading-tight sm:text-[10px]">¡Logro desbloqueado y añadido a tu perfil!</p>
                </div>
              `;
              document.body.appendChild(toast);
              requestAnimationFrame(() => {
                toast.classList.remove('-translate-y-16', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
              });
              setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-16', 'opacity-0');
                setTimeout(() => toast.remove(), 500);
              }, 4000);
            }, 1200);
          }
        }, 200);
      },
    },
    {
      emoji: '🤖',
      title: 'Asistente IA Cultural (Edi)',
      description:
        'Pregúntale lo que quieras: "Recomiéndame una ruta cultural" o "Háblame de Bellas Artes". Edi conoce todo el patrimonio del mapa.',
      spotlightSelector: '#ai-fab',
      annotation: 'Haz clic aquí para chatear con Edi',
    },
    {
      emoji: '🚀',
      title: 'Navegación Demo Activa',
      description:
        'Estás en el entorno de demostración interactivo de EdificARTE. Toca cualquier pin o botón para explorar libremente.',
    },
  ];

  let currentStep = 0;

  function updateDemo() {
    const step = steps[currentStep];
    const demoEmoji = document.getElementById('demo-emoji');
    const demoTitle = document.getElementById('demo-title');
    const demoDescription = document.getElementById('demo-description');
    const demoSpotlight = document.getElementById('demo-spotlight');
    const demoAnnotation = document.getElementById('demo-annotation');
    const demoAnnotationText = document.getElementById('demo-annotation-text');
    const btnNext = document.getElementById('btn-demo-next');
    const progressDots = document.querySelectorAll('.progress-dot');

    if (!demoEmoji || !demoTitle || !demoDescription || !btnNext) return;

    // Smooth emoji transition
    demoEmoji.style.transform = 'scale(0)';
    setTimeout(() => {
      demoEmoji.textContent = step.emoji;
      demoEmoji.style.transform = 'scale(1)';
    }, 150);

    demoTitle.textContent = step.title;
    demoDescription.textContent = step.description;

    // Update progress dots
    progressDots.forEach((dot, idx) => {
      if (idx <= currentStep) {
        dot.classList.remove('bg-slate-300', 'dark:bg-slate-700');
        dot.classList.add('bg-accent-600');
      } else {
        dot.classList.add('bg-slate-300', 'dark:bg-slate-700');
        dot.classList.remove('bg-accent-600');
      }
    });

    // Update button text
    if (currentStep === steps.length - 1) {
      btnNext.textContent = 'Explorar Demo';
    } else {
      btnNext.textContent = 'Siguiente';
    }

    // Handle spotlight and annotation
    if (step.spotlightSelector && demoSpotlight) {
      const target = document.querySelector(step.spotlightSelector) as HTMLElement;

      if (target) {
        const rect = target.getBoundingClientRect();
        demoSpotlight.style.display = 'block';
        demoSpotlight.style.width = `${rect.width + 16}px`;
        demoSpotlight.style.height = `${rect.height + 16}px`;
        demoSpotlight.style.left = `${rect.left - 8}px`;
        demoSpotlight.style.top = `${rect.top - 8}px`;

        if (step.annotation && demoAnnotation && demoAnnotationText) {
          demoAnnotationText.textContent = step.annotation;
          demoAnnotation.style.display = 'block';

          const annotTop = rect.bottom + 16;
          const annotLeft = rect.left + rect.width / 2;
          demoAnnotation.style.left = `${annotLeft}px`;
          demoAnnotation.style.top = `${annotTop}px`;
          demoAnnotation.style.transform = 'translateX(-50%)';
        }
      } else {
        demoSpotlight.style.display = 'none';
        if (demoAnnotation) demoAnnotation.style.display = 'none';
      }
    } else {
      if (demoSpotlight) demoSpotlight.style.display = 'none';
      if (demoAnnotation) demoAnnotation.style.display = 'none';
    }

    step.action?.();
  }

  function finishOrSkipDemo() {
    const demoControls = document.getElementById('demo-controls');
    const demoSpotlight = document.getElementById('demo-spotlight');
    const demoAnnotation = document.getElementById('demo-annotation');

    if (demoControls) demoControls.style.display = 'none';
    if (demoSpotlight) demoSpotlight.style.display = 'none';
    if (demoAnnotation) demoAnnotation.style.display = 'none';
  }

  function nextStep() {
    if (currentStep < steps.length - 1) {
      currentStep++;
      updateDemo();
    } else {
      finishOrSkipDemo();
    }
  }

  document.getElementById('btn-demo-next')?.addEventListener('click', nextStep);
  document.getElementById('btn-demo-skip')?.addEventListener('click', finishOrSkipDemo);

  setTimeout(() => {
    updateDemo();
  }, 500);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === ' ') {
      e.preventDefault();
      nextStep();
    } else if (e.key === 'Escape') {
      finishOrSkipDemo();
    }
  });
</script>

<style>
  .liquid-glass {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  :global(.dark) .liquid-glass {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  #demo-spotlight {
    animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse-ring {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Map Markers & Pins */
  :global(.edificarte-pin),
  :global(.turimap-pin) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.12);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
    font-size: 18px;
  }
  .dark :global(.edificarte-pin),
  .dark :global(.turimap-pin) {
    background: rgba(15, 23, 42, 0.75) !important;
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
  :global(.edificarte-pin:hover),
  :global(.turimap-pin:hover) {
    transform: scale(1.15);
    border-color: rgba(37, 99, 235, 0.6);
    box-shadow: 0 0 20px rgba(37, 99, 235, 0.3);
  }
  :global(.edificarte-pin.selected),
  :global(.turimap-pin.selected) {
    border-color: rgba(37, 99, 235, 0.8);
    box-shadow:
      0 0 0 4px rgba(37, 99, 235, 0.2),
      0 4px 20px rgba(37, 99, 235, 0.4);
    transform: scale(1.25) translateY(-4px);
    z-index: 1000 !important;
    background: rgba(37, 99, 235, 0.3);
  }

  /* Cluster pins */
  :global(.edificarte-pin-cluster),
  :global(.turimap-pin-cluster) {
    width: 46px;
    height: 46px;
    border-color: rgba(37, 99, 235, 0.55);
    box-shadow: 0 4px 18px rgba(37, 99, 235, 0.22);
  }
  .dark :global(.edificarte-pin-cluster),
  .dark :global(.turimap-pin-cluster) {
    border-color: rgba(96, 165, 250, 0.55);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
  }
  :global(.edificarte-pin-cluster-count),
  :global(.turimap-pin-cluster-count) {
    font-size: 15px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: #1d4ed8;
  }
  .dark :global(.edificarte-pin-cluster-count),
  .dark :global(.turimap-pin-cluster-count) {
    color: #93c5fd;
  }

  /* GPS User Location Dot */
  :global(.user-dot) {
    position: relative;
    width: 20px;
    height: 20px;
    background: #2563eb;
    border: 3px solid white;
    border-radius: 50%;

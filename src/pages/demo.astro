---
import Layout from '../layouts/Layout.astro';
import AiAgent from '../components/AiAgent.astro';
import UnifiedSearchBar from '../components/UnifiedSearchBar.astro';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import esDict from '../i18n/es.json';
import enDict from '../i18n/en.json';

const locale = (Astro.currentLocale as Locale) || DEFAULT_LOCALE;
const dict = locale === 'es' ? esDict : enDict;

const runtimeEnv = Astro.locals?.runtime?.env;
const mapboxToken =
  runtimeEnv?.MAPBOX_TOKEN || import.meta.env.MAPBOX_TOKEN || '';
---

<Layout title={`EdificARTE - ${dict.demo?.title || 'Demo Mode'}`} fullScreen={true} locale={locale}>
  <!-- Fake GPS: Centro Cultural El Rule coordinates - MUST run FIRST -->
  <script is:inline define:vars={{ mapboxToken }}>
    window.__EDIFICARTE_TOKEN__ = mapboxToken;
    window.__TURIMAP_TOKEN__ = mapboxToken;
    window.__DEMO_MODE__ = true;
    window.__DEMO_FAST_LOAD__ = true;

    // Force fake GPS IMMEDIATELY - block any real geolocation
    (function () {
      var DEMO_LAT = 19.4340;
      var DEMO_LNG = -99.1415;

      var pos = {
        coords: {
          latitude: DEMO_LAT,
          longitude: DEMO_LNG,
          accuracy: 5,
          altitude: null,
          altitudeAccuracy: null,
          heading: null,
          speed: null
        },
        timestamp: Date.now()
      };

      // Store demo position globally
      window.__DEMO_POSITION__ = pos;

      // Override navigator.geolocation immediately and permanently
      var fakeGeo = {
        watchPosition: function (success, error, options) {
          console.log('[DEMO] Fake GPS watchPosition called');
          setTimeout(function() { success(pos); }, 0);
          return 1;
        },
        getCurrentPosition: function (success, error, options) {
          console.log('[DEMO] Fake GPS getCurrentPosition called');
          setTimeout(function() { success(pos); }, 0);
        },
        clearWatch: function () {
          console.log('[DEMO] Fake GPS clearWatch called');
        }
      };

      // Force override with non-configurable property
      Object.defineProperty(navigator, 'geolocation', {
        get: function () { return fakeGeo; },
        configurable: false,
        enumerable: true
      });

      console.log('[DEMO] Fake GPS activated at', DEMO_LAT, DEMO_LNG);
    })();
  </script>

  <!-- Demo Overlay Controls -->
  <div
    id="demo-controls"
    class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center transition-opacity duration-500"
  >
    <!-- Demo Card -->
    <div
      id="demo-card"
      class="liquid-glass pointer-events-auto relative mx-4 w-full max-w-md rounded-3xl p-5 shadow-2xl sm:p-6"
      style="box-shadow: 0 0 0 100vmax rgba(0, 0, 0, 0.2);"
    >
      <!-- Progress Indicator -->
      <div class="mb-3 flex gap-1.5 sm:mb-4">
        <div class="progress-dot h-2 flex-1 rounded-full bg-accent-600 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
        <div class="progress-dot h-2 flex-1 rounded-full bg-slate-300 dark:bg-slate-700 transition-all duration-300"></div>
      </div>

      <!-- Content -->
      <div id="demo-content">
        <div class="mb-2 flex items-center gap-2">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-600 text-xl transition-transform duration-300 sm:h-10 sm:w-10"
            id="demo-emoji"
          >
            🌍
          </span>
          <h2
            class="text-lg font-bold text-slate-800 dark:text-white sm:text-xl"
            id="demo-title"
            data-i18n="demo.title"
          >
            {dict.demo?.title || 'Bienvenido a EdificARTE'}
          </h2>
        </div>
        <p
          class="mb-5 text-[12px] leading-relaxed text-slate-600 dark:text-slate-300 sm:mb-6 sm:text-[13px]"
          id="demo-description"
          data-i18n="demo.description"
        >
          {dict.demo?.description || 'Descubre el patrimonio cultural con guías de IA, experiencias inmersivas y recorridos de audio multilingües.'}
        </p>
      </div>

      <!-- Actions -->
      <div class="flex gap-2.5 sm:gap-3">
        <button
          id="btn-demo-skip"
          data-i18n="demo.skip"
          class="flex-1 rounded-xl border border-slate-200 px-3 py-2 text-[11px] font-semibold text-slate-600 transition-all hover:bg-slate-100 active:scale-95 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 sm:px-4 sm:py-2.5 sm:text-[12px]"
        >
          {dict.demo?.skip || 'Omitir'}
        </button>
        <button
          id="btn-demo-next"
          data-i18n="demo.next"
          class="flex-1 rounded-xl bg-accent-600 px-3 py-2 text-[11px] font-semibold text-white shadow-lg shadow-accent-600/20 transition-all hover:bg-accent-700 active:scale-95 sm:px-4 sm:py-2.5 sm:text-[12px]"
        >
          {dict.demo?.next || 'Siguiente'}
        </button>
      </div>
    </div>
  </div>

  <!-- Demo Spotlight -->
  <div
    id="demo-spotlight"
    class="pointer-events-none fixed z-40 hidden rounded-2xl border-4 border-accent-500 shadow-[0_0_0_9999px_rgba(0,0,0,0.5)] transition-all duration-700 ease-in-out"
  ></div>

  <!-- Demo Annotations (floating hints) -->
  <div
    id="demo-annotation"
    class="liquid-glass pointer-events-none fixed z-40 hidden max-w-[85vw] rounded-2xl px-3.5 py-2.5 shadow-xl transition-all duration-500 sm:max-w-xs sm:px-4 sm:py-3"
  >
    <p class="text-[10px] font-semibold text-slate-700 dark:text-slate-200 sm:text-[11px]" id="demo-annotation-text"></p>
  </div>

  <!-- Embedded Map Page -->
  <div class="h-screen w-full">
    <!-- Floating Search Bar -->
    <div
      class="unified-search-map-layer pointer-events-none absolute left-0 right-0 top-0 z-30 flex flex-col items-center gap-2 px-4 pt-2"
    >
      <UnifiedSearchBar
        inputId="search-input"
        clearId="map-search-clear"
        suggestionsId="search-suggestions"
        placeholder="Buscar lugares, ciudades y monumentos..."
        ariaLabel="Buscar lugares"
        i18nPlaceholder="mapa.search_placeholder"
        outerClass="pointer-events-auto"
      />

      <!-- Filter Chips -->
      <div
        id="map-filter-chips"
        class="no-scrollbar pointer-events-auto relative z-10 -mx-4 flex w-full max-w-lg gap-2 overflow-x-auto scroll-smooth px-4 pb-3 pt-1 sm:flex-wrap sm:justify-center sm:overflow-x-visible"
      >
        <button
          data-filter="all"
          data-i18n="mapa.filters.all"
          class="filter-chip active flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          Todos
        </button>
        <button
          data-filter="museum"
          data-i18n="mapa.filters.museums"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          🏛️ Museos
        </button>
        <button
          data-filter="temple"
          data-i18n="mapa.filters.temples"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          ⛪ Templos
        </button>
        <button
          data-filter="park"
          data-i18n="mapa.filters.parks"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          🌳 Parques
        </button>
        <button
          data-filter="historic"
          data-i18n="mapa.filters.historic"
          class="filter-chip flex-shrink-0 rounded-full border px-4 py-[7px] text-[11px] font-bold shadow-sm transition-all active:scale-95"
        >
          🏰 Histórico
        </button>
      </div>
    </div>

    <!-- Floating Controls -->
    <div
      id="map-floating-controls"
      class="pointer-events-auto fixed right-3 z-30 flex flex-col items-end gap-2 transition-all duration-300 ease-in-out sm:right-4"
      style="bottom: calc(8.25rem + env(safe-area-inset-bottom, 0px));"
    >
      <button
        id="btn-locate"
        class="liquid-glass flex h-11 w-11 items-center justify-center rounded-full text-slate-700 shadow-lg transition-all active:scale-90 dark:text-slate-200"
        aria-label="Centrar ubicación"
      >
        <span class="material-symbols-outlined text-[20px]" id="locate-icon"
          >my_location</span
        >
      </button>
    </div>

    <!-- Fullscreen Map -->
    <div id="map" class="absolute inset-0 z-0 h-full w-full"></div>

    <!-- Bottom Sheet -->
    <div
      id="bottom-sheet"
      class="liquid-glass absolute left-3 right-3 z-20 mx-auto max-w-lg overflow-hidden rounded-3xl transition-all duration-300"
      style="bottom: calc(5.25rem + env(safe-area-inset-bottom, 0px));"
    >
      <div
        id="sheet-header"
        class="relative flex w-full cursor-pointer select-none items-center justify-between px-4 pb-3.5 pt-4 transition-colors sm:px-5"
      >
        <div
          class="pointer-events-none absolute left-1/2 top-1.5 h-1 w-9 -translate-x-1/2 rounded-full bg-slate-300/80 dark:bg-slate-700/80"
        >
        </div>
        <h2
          class="flex items-center gap-2 text-[14px] font-bold text-slate-800 dark:text-white"
        >
          <span
            class="material-symbols-outlined text-[18px] text-accent-600 dark:text-accent-400"
            >explore</span
          >
          <span data-i18n="mapa.sheet.title">Lugares Cercanos</span>
        </h2>
        <span
          id="sheet-chevron"
          class="material-symbols-outlined text-[20px] text-slate-400 transition-transform duration-300 dark:text-slate-500"
          >keyboard_arrow_up</span
        >
      </div>

      <div
        id="sheet-body"
        class="overflow-y-auto px-4 pb-5 transition-all duration-300 ease-in-out"
      >
        <div id="view-list">
          <div
            class="no-scrollbar flex flex-col gap-2"
            id="places-list-container"
          >
            <p
              class="py-6 text-center text-[12px] text-slate-400 dark:text-slate-500"
              data-i18n="mapa.sheet.empty_cta"
            >
              Cargando patrimonio cercano...
            </p>
          </div>
        </div>
        <!-- Detail View -->
        <div id="view-detail" class="hidden">
          <div class="mb-2.5 flex items-start justify-between">
            <div class="flex gap-2.5">
              <span
                id="detail-emoji"
                class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-slate-100 text-xl dark:bg-slate-800"
                >📍</span
              >
              <div>
                <h3
                  id="detail-name"
                  class="text-[13px] font-bold leading-tight text-slate-800 dark:text-white"
                >
                  Lugar
                </h3>
                <p
                  id="detail-category"
                  class="mt-0.5 text-[11px] font-medium text-slate-500 dark:text-slate-400"
                >
                  Categoría
                </p>
              </div>
            </div>
            <button
              id="btn-close-detail"
              class="rounded-full p-1 text-slate-400 transition-colors hover:bg-slate-100 dark:text-slate-500 dark:hover:bg-slate-800"
              aria-label="Cerrar detalle"
            >
              <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
          </div>

          <p
            id="detail-address"
            class="mb-3 text-[11px] leading-relaxed text-slate-500 dark:text-slate-400"
          >
          </p>

          <!-- Wikipedia enrichment: hidden until a match is found -->
          <div
            id="detail-wiki"
            class="mb-3.5 hidden overflow-hidden rounded-xl border border-slate-200/80 bg-slate-50 dark:border-slate-800/60 dark:bg-slate-900/60"
          >
            <div
              class="relative h-32 w-full overflow-hidden bg-slate-100 dark:bg-slate-800"
            >
              <img
                id="detail-wiki-img"
                src=""
                alt=""
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="flex items-center justify-between px-3 py-2">
              <span
                class="flex items-center gap-1 text-[10px] font-semibold text-slate-400 dark:text-slate-500"
              >
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"
                  ><path
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93s3.06-7.44 7-7.93v15.86zm2 0V4.07c3.94.49 7 3.85 7 7.93s-3.06 7.44-7 7.93z"
                  ></path></svg
                >
                Wikipedia
              </span>
              <a
                id="detail-wiki-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="shadow-xs inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-[10px] font-bold text-brand-600 transition-all hover:bg-brand-50 active:scale-95 dark:border-slate-700 dark:bg-slate-800 dark:text-brand-400 dark:hover:bg-brand-950/30"
              >
                Ver artículo
                <span class="material-symbols-outlined text-[11px]"
                  >open_in_new</span
                >
              </a>
            </div>
          </div>

          <!-- VR Video Experience Container: shown when isVRAvailable or videoUrl exists -->
          <div
            id="detail-vr-container"
            class="mb-3.5 hidden overflow-hidden rounded-2xl border border-accent-500/25 bg-white p-2 shadow-md dark:border-accent-400/30 dark:bg-accent-950"
          >
            <div class="mb-2 flex items-center justify-between px-1.5 pt-1">
              <span
                class="inline-flex items-center gap-1.5 text-[11px] font-extrabold text-accent-500 dark:text-accent-300"
              >
                <span class="material-symbols-outlined text-[16px]"
                  >view_in_ar</span
                >
                Experiencia Realidad Virtual (360 VR)
              </span>
              <span
                class="rounded-full bg-accent-500/10 px-2.5 py-0.5 text-[9px] font-extrabold uppercase tracking-wider text-accent-500 dark:bg-accent-400/20 dark:text-accent-200"
                >VR 360</span
              >
            </div>
            <div
              class="relative aspect-video w-full overflow-hidden rounded-xl bg-accent-950 shadow-inner"
            >
              <iframe
                id="detail-vr-iframe"
                src=""
                title="VR Video Experience"
                class="h-full w-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
            </div>
          </div>

          <!-- Audio Player Block -->
          <div
            id="detail-audio-container"
            class="mb-3.5 hidden w-full overflow-hidden rounded-2xl border border-accent-500/20 bg-slate-50/90 p-3.5 shadow-sm dark:border-slate-800/60 dark:bg-slate-900/60"
          >
            <button
              id="btn-play-audio"
              type="button"
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent-600 px-4 py-2.5 font-semibold text-white shadow-md shadow-accent-600/20 transition-all hover:bg-accent-700 active:scale-[0.97]"
            >
              <span
                class="material-symbols-outlined text-[18px]"
                style="font-variation-settings:'FILL' 1">play_arrow</span
              >
              <span class="text-[12px]"
                >Escuchar Audioguía (<span id="detail-duration">1:50</span>)</span
              >
            </button>

            <div id="audio-player" class="hidden space-y-2.5 pt-2.5">
              <div class="flex items-center justify-between">
                <span
                  class="flex items-center gap-1.5 text-[11px] font-bold text-accent-600 dark:text-accent-400"
                >
                  <span class="relative flex h-2 w-2">
                    <span
                      class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-500 opacity-60"
                    ></span>
                    <span
                      class="relative inline-flex h-2 w-2 rounded-full bg-accent-500"
                    ></span>
                  </span>
                  <span id="audio-status-label">Escuchando...</span>
                </span>
                <span
                  id="player-time"
                  class="font-mono text-[10px] font-semibold text-slate-500 dark:text-slate-400"
                  >0:00 / 1:50</span
                >
              </div>
              <div
                class="h-1.5 w-full cursor-pointer overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"
                id="progress-bar-container"
              >
                <div
                  id="progress-bar-fill"
                  class="h-full w-0 rounded-full bg-accent-600 transition-all duration-200 dark:bg-accent-400"
                ></div>
              </div>
              <div class="flex justify-end gap-2 pt-0.5">
                <button
                  id="btn-player-toggle"
                  type="button"
                  class="inline-flex items-center gap-1 rounded-lg bg-slate-200 px-3 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                >
                  <span id="player-toggle-icon" class="material-symbols-outlined text-[14px]">pause</span>
                  <span>Pausar</span>
                </button>
                <button
                  id="btn-player-stop"
                  type="button"
                  class="inline-flex items-center gap-1 rounded-lg bg-slate-200 px-3 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                >
                  <span class="material-symbols-outlined text-[14px]">stop</span>
                  <span>Detener</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Action buttons -->
          <div class="flex gap-2">
            <button
              id="btn-navigate"
              data-i18n="mapa.detail.navigate"
              class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-accent-600 px-4 py-2 font-semibold text-white shadow-lg shadow-accent-600/20 transition-all hover:bg-accent-700 active:scale-[0.97]"
            >
              <span class="material-symbols-outlined text-[16px]">directions</span>
              <span class="text-[11px]">Cómo llegar</span>
            </button>
            <button
              id="btn-share"
              class="flex items-center justify-center rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 text-slate-600 transition-all hover:bg-slate-100 active:scale-[0.97] dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:bg-slate-800/80"
              aria-label="Compartir"
            >
              <span class="material-symbols-outlined text-[16px]">share</span>
            </button>
          </div>

          <!-- Route info (shown when navigating) -->
          <div id="route-info" class="mt-3 hidden">
            <div
              class="flex items-center justify-between rounded-xl border border-accent-500/20 bg-accent-500/10 px-3 py-2.5"
            >
              <div class="flex items-center gap-2">
                <span
                  id="route-mode-icon"
                  class="material-symbols-outlined text-[18px] text-accent-400"
                  >directions</span
                >
                <span
                  id="route-info-text"
                  class="text-[12px] font-semibold text-accent-300"
                  data-i18n="mapa.detail.calculating">Calculando ruta...</span
                >
              </div>
              <button
                id="btn-cancel-route"
                data-i18n="mapa.detail.cancel"
                class="flex items-center gap-1 rounded-lg bg-white/10 px-2.5 py-1 text-[11px] font-semibold text-white/70 transition-all hover:bg-white/15 active:scale-95"
              >
                <span class="material-symbols-outlined text-[14px]">close</span>
                Cancelar
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Zone Card (regions/sectors) -->
    <div
      id="zone-card"
      class="liquid-glass hidden w-[19rem] overflow-hidden rounded-3xl shadow-xl"
      role="dialog"
      aria-modal="false"
      aria-labelledby="zone-card-name"
    >
      <div id="zone-card-accent" class="h-1.5 w-full bg-slate-400"></div>

      <div class="px-4 pb-4 pt-3">
        <div class="flex items-start gap-3">
          <span
            id="zone-card-emoji"
            class="text-2xl leading-none"
            aria-hidden="true">🏛️</span
          >
          <div class="min-w-0 flex-1">
            <p
              id="zone-card-kind"
              class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"
            >
              Zona
            </p>
            <h3
              id="zone-card-name"
              class="truncate text-base font-bold text-slate-900 dark:text-white"
            >
            </h3>
            <p
              id="zone-card-meta"
              class="mt-0.5 text-xs text-slate-500 dark:text-slate-400"
            >
            </p>
          </div>
          <button
            id="zone-card-close"
            class="pointer-events-auto -mr-1 -mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-black/5 dark:text-slate-400 dark:hover:bg-white/10"
            aria-label="Cerrar información de zona"
          >
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true"
              >close</span
            >
          </button>
        </div>

        <p
          id="zone-card-desc"
          class="mt-2.5 text-sm leading-snug text-slate-700 dark:text-slate-300"
        >
        </p>

        <div
          id="zone-card-fact-wrap"
          class="mt-2.5 hidden rounded-xl bg-black/[0.04] px-3 py-2 dark:bg-white/[0.06]"
        >
          <p
            class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"
          >
            ¿Sabías que?
          </p>
          <p
            id="zone-card-fact"
            class="mt-0.5 text-xs leading-snug text-slate-700 dark:text-slate-300"
          >
          </p>
        </div>

        <p
          id="zone-card-approx"
          class="mt-2.5 hidden text-[11px] leading-snug text-amber-700 dark:text-amber-400"
        >
          Área aproximada — no hay límites oficiales publicados para esta zona.
        </p>

        <div class="mt-3 flex items-center gap-2">
          <a
            id="zone-card-wiki"
            class="inline-flex items-center gap-1.5 rounded-full bg-black/[0.06] px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:bg-black/10 dark:bg-white/10 dark:text-slate-200 dark:hover:bg-white/20"
            target="_blank"
            rel="noopener noreferrer"
          >
            Leer más
          </a>
          <button
            id="zone-card-fit"

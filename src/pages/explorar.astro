<script>
  import { MONUMENTS } from '../data/monuments';
  import metalinguaWorks from '../data/metalingua-works.json';
  import type { Tour } from '../data/tours';
  import { detectLocale, pickLocalized } from '../lib/i18n';
  import { navigate } from 'astro:transitions/client';

  type I18nDict = Record<string, unknown>;

  const TOURS: Tour[] = (window as unknown as { __EDIFICARTE_TOURS__?: Tour[]; __TURIMAP_TOURS__?: Tour[] }).__EDIFICARTE_TOURS__ || (window as unknown as { __TURIMAP_TOURS__?: Tour[] }).__TURIMAP_TOURS__ || [];

  document.addEventListener('astro:page-load', () => {
    // --- i18n runtime (mirrors tienda.astro; dicts injected globally by Layout) ---
    // The handler re-runs on every astro:page-load, so abort the previous
    // controller to drop stale document/window-level listeners before re-binding.
    const win = window as unknown as {
      __EDIFICARTE_I18N__?: { es: I18nDict; en: I18nDict };
      __TURIMAP_I18N__?: { es: I18nDict; en: I18nDict };
      __turimapExplorarController?: AbortController;
    };
    if (win.__turimapExplorarController) {
      win.__turimapExplorarController.abort();
    }
    const explorarController = new AbortController();
    win.__turimapExplorarController = explorarController;

    const DICTS = (win.__EDIFICARTE_I18N__ || win.__TURIMAP_I18N__ || { es: {}, en: {} });
    function getDict(): I18nDict {
      return detectLocale() === 'en' ? DICTS.en : DICTS.es;
    }
    const _dict = getDict();
    function resolve(dict: I18nDict, key: string): string {
      const parts = key.split('.');
      let cur: unknown = dict;
      for (const p of parts) {
        if (cur && typeof cur === 'object' && p in cur) cur = (cur as I18nDict)[p];
        else return key;
      }
      return typeof cur === 'string' ? cur : key;
    }
    function tr(key: string, vars?: Record<string, string | number>): string {
      let s = resolve(_dict, key);
      if (!vars) return s;
      s = s.replace(/\{(\w+)\}/g, function (_, n) {
        return n in vars ? String(vars[n]) : '{' + n + '}';
      });
      return s;
    }
    function applyI18n() {
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (!key) return;
        el.innerHTML = tr(key);
      });
      document.querySelectorAll('[data-i18n-html]').forEach((el) => {
        const key = el.getAttribute('data-i18n-html');
        if (!key) return;
        el.innerHTML = tr(key);
      });
      document.querySelectorAll('[data-i18n-attr]').forEach((el) => {
        const v = el.getAttribute('data-i18n-attr');
        if (!v) return;
        // Supports comma-separated attr|key pairs (e.g. aria-label + title).
        v.split(',').forEach((pair) => {
          const [attr, key] = pair.split('|');
          if (attr && key) el.setAttribute(attr, tr(key));
        });
      });
      document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (key) el.setAttribute('placeholder', tr(key));
      });
    }

    // Helpers para conversión USDC
    const MXN_PER_USDC = 17;
    function mxnToUsdc(mxn: number): number {
      return Math.round((mxn / MXN_PER_USDC) * 100) / 100;
    }
    function rawUsdc(usdc: number): string {
      const [w, d = ''] = String(usdc).split('.');
      const decPadded = (d + '0'.repeat(6)).slice(0, 6);
      const raw = BigInt(w) * BigInt(1000000) + BigInt(decPadded || '0');
      return raw.toString();
    }
    // Filtrado y búsqueda client-side de experiencias con secciones horizontales.
    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const sections = document.querySelectorAll<HTMLElement>('.category-section');
    const emptyState = document.getElementById('empty-state');
    const searchInput = document.getElementById('explore-search-input') as HTMLInputElement;
    const searchClear = document.getElementById('explore-search-clear');

    let activeCategory = 'todos';
    let searchQuery = '';
    // Do not expose country-targeted managed/static cards before the browser has
    // produced a confirmed country. Unknown, denied, and failed resolution are
    // intentionally empty rather than defaulting to Mexico.
    let activeCountry = '__unknown__';

    const locationStatus = document.getElementById('explore-location-status');
    function setLocationStatus(message: string, iconName: string = 'near_me', state: 'neutral' | 'success' | 'warning' = 'neutral') {
      if (!locationStatus) return;
      const textEl = locationStatus.querySelector('#explore-location-text') || locationStatus;
      const iconEl = locationStatus.querySelector('#explore-location-icon');
      if (textEl) textEl.textContent = message;
      if (iconEl) iconEl.textContent = iconName;

      const baseClasses = 'explore-location-pill inline-flex items-center gap-2 px-4 py-2 text-[11px] font-medium transition-colors duration-300';
      if (state === 'success') {
        locationStatus.className = `${baseClasses} is-success`;
        if (iconEl) iconEl.className = 'material-symbols-outlined text-[15px] shrink-0 text-emerald-600 dark:text-emerald-400';
      } else if (state === 'warning') {
        locationStatus.className = `${baseClasses} is-warning`;
        if (iconEl) iconEl.className = 'material-symbols-outlined text-[15px] shrink-0 text-amber-600 dark:text-amber-400';
      } else {
        locationStatus.className = baseClasses;
        if (iconEl) iconEl.className = 'material-symbols-outlined text-[15px] shrink-0 text-slate-500 dark:text-slate-400';
      }
    }
    function calculateKmDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
      const R = 6371;
      const dLat = (lat2 - lat1) * (Math.PI / 180);
      const dLon = (lon2 - lon1) * (Math.PI / 180);
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(lat1 * (Math.PI / 180)) * Math.cos(lat2 * (Math.PI / 180)) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
    }

    function escapeHtml(str: unknown): string {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function injectPublicItemsIntoCategories(items: Array<{ title: string; description: string; sourceName?: string; sourceUrl?: string; imageUrl?: string }>) {
      if (!items || !items.length) return;
      const defaultPhoto = 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=600&q=80';

      items.forEach((item) => {
        if (!item.title) return;
        const wikiId = `wiki-${item.title.replace(/\s+/g, '-').toLowerCase()}`;
        if (document.querySelector(`[data-id="${wikiId}"]`)) return;

        // Use server-side category hint when available (set by targeted text queries).
        // Fall back to keyword detection only when hint is absent.
        // Education is checked first to prevent universities from landing in museo/turismo.
        let cat: string = (item as { categoryHint?: string }).categoryHint || 'turismo';
        if (!(item as { categoryHint?: string }).categoryHint) {
          const titleDesc = `${item.title} ${item.description || ''}`.toLowerCase();
          if (/\buniversidad\b|university|\bpolitécnico\b|politecnic|\btecnológico\b|\bescuela (de |superior|nacional|politécnica)|\binstituto tecnol|\bfacultad (de |nacional)/.test(titleDesc)) {
            cat = 'educacion';
          } else if (/\bmuseo\b|museum|\bgaler[íi]a\b|\bteatro\b|\bauditorio\b/.test(titleDesc)) {
            cat = 'museo';
          } else if (/gastronom[íi]|restaurante|restauran\b/.test(titleDesc)) {
            cat = 'gastronomia';
          } else if (/\bevento\b|\bfestival\b|\bconcierto\b|exposici[oó]n/.test(titleDesc)) {
            cat = 'eventos';
          }
        }

        const targetSection = document.querySelector<HTMLElement>(`.category-section[data-render-categories*="${cat}"], .category-section[data-category="${cat}"]`);
        const container = targetSection?.querySelector<HTMLElement>('.scroll-container');
        if (!container) return;

        const card = document.createElement('article');
        card.className = 'exp-card group relative flex h-[350px] w-[250px] sm:w-[270px] flex-none snap-start flex-col overflow-hidden rounded-2xl border border-slate-200/50 dark:border-slate-800/50 bg-white dark:bg-slate-900 shadow-sm transition-all duration-300 hover:shadow-md';
        card.setAttribute('data-category', cat);
        card.setAttribute('data-title', item.title);
        card.setAttribute('data-desc', item.description || '');
        card.setAttribute('data-id', wikiId);
        card.setAttribute('data-country', activeCountry);
        card.setAttribute('data-is-product', 'false');
        card.setAttribute('data-is-vr', 'false');

        const imgUrl = item.imageUrl || defaultPhoto;
        const sourceLabel = item.sourceName || 'Wikipedia';

        card.innerHTML = `
          <div class="relative h-44 w-full overflow-hidden rounded-t-2xl bg-slate-100 dark:bg-slate-900">
            <img src="${escapeHtml(imgUrl)}" alt="${escapeHtml(item.title)}" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.src='${defaultPhoto}'" />
            <span class="absolute top-3 left-3 rounded-lg px-2 py-0.5 font-bold text-[10px] uppercase tracking-wider backdrop-blur-md border border-sky-200/60 bg-sky-50/90 text-sky-700 dark:border-sky-800/60 dark:bg-sky-950/80 dark:text-sky-300">
              ${escapeHtml(sourceLabel)}
            </span>
          </div>
          <div class="flex flex-1 flex-col justify-between p-4 bg-white dark:bg-slate-900">
            <div>
              <h2 class="text-sm font-bold tracking-tight text-slate-800 dark:text-slate-100 line-clamp-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">${escapeHtml(item.title)}</h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs tracking-tight mt-1.5 line-clamp-2 leading-relaxed">${escapeHtml(item.description || '')}</p>
            </div>
            <div class="mt-auto pt-3 flex items-center gap-1.5 text-[11px] font-semibold text-slate-700 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800/60">
              <span class="text-slate-400 dark:text-slate-500 font-normal">${tr('explorar.cards.recommended')}</span>
              ${item.sourceUrl ? `
                <a href="${escapeHtml(item.sourceUrl)}" target="_blank" rel="noopener noreferrer" class="ml-auto inline-flex items-center gap-1 rounded-xl bg-brand-50 hover:bg-brand-100 dark:bg-brand-950/20 dark:hover:bg-brand-950/40 text-brand-600 dark:text-brand-400 font-bold px-3 py-1.5 text-[11px] shadow-sm transition-all active:scale-[0.97]">
                  <span>${tr('explorar.cards.view_article')}</span>
                  <span class="material-symbols-outlined text-[12px]">open_in_new</span>
                </a>
              ` : ''}
            </div>
          </div>
        `;
        container.appendChild(card);
      });

      updateList();
    }

    function renderLocationResults(data: { managed?: Array<{ title: string; description: string; imageUrl?: string }>; publicInfo?: Array<{ title: string; description: string; sourceName: string; sourceUrl: string; imageUrl?: string }> }) {
      if (data.publicInfo && data.publicInfo.length > 0) {
        injectPublicItemsIntoCategories(data.publicInfo);
      }
    }

    function sortCardsByProximity(userLat: number, userLng: number) {
      document.querySelectorAll<HTMLElement>('.category-section').forEach((section) => {
        const container = section.querySelector<HTMLElement>('.scroll-container');
        if (!container) return;
        const cards = Array.from(container.querySelectorAll<HTMLElement>('.exp-card'));
        cards.sort((a, b) => {
          const latA = parseFloat(a.dataset.lat || '');
          const lngA = parseFloat(a.dataset.lng || '');
          const latB = parseFloat(b.dataset.lat || '');
          const lngB = parseFloat(b.dataset.lng || '');
          const distA = (!isNaN(latA) && !isNaN(lngA)) ? calculateKmDistance(userLat, userLng, latA, lngA) : 999999;
          const distB = (!isNaN(latB) && !isNaN(lngB)) ? calculateKmDistance(userLat, userLng, latB, lngB) : 999999;
          return distA - distB;
        });

        cards.forEach((card) => {
          const lat = parseFloat(card.dataset.lat || '');
          const lng = parseFloat(card.dataset.lng || '');
          if (!isNaN(lat) && !isNaN(lng)) {
            const dist = calculateKmDistance(userLat, userLng, lat, lng);
            const distStr = dist < 1 ? `${Math.round(dist * 1000)} m` : `${dist.toFixed(1)} km`;
            let distBadge = card.querySelector<HTMLElement>('.card-distance-badge');
            if (!distBadge) {
              distBadge = document.createElement('span');
              distBadge.className = 'card-distance-badge ml-auto text-[10px] font-semibold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/40 px-2 py-0.5 rounded-md border border-brand-200/50';
              const footer = card.querySelector('.mt-auto');
              if (footer) footer.insertBefore(distBadge, footer.firstChild);
            }
            distBadge.textContent = tr('explorar.cards.distance_away', { dist: distStr });
          }
          container.appendChild(card);
        });
      });
    }

    function filterLocationCards(countryCode: string) {
      activeCountry = countryCode.toUpperCase();
      updateList();
    }

    function requestExploreLocation() {
      if (!navigator.geolocation) { setLocationStatus(tr('explorar.location.unsupported'), 'location_off', 'warning'); updateList(); return; }
      setLocationStatus(tr('explorar.location.searching'), 'near_me', 'neutral');
      navigator.geolocation.getCurrentPosition(async ({ coords }) => {
        try {
          sortCardsByProximity(coords.latitude, coords.longitude);
          const response = await fetch('/api/explore/location', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ latitude: coords.latitude, longitude: coords.longitude }) });
          const data = await response.json();
          if (data.location?.status !== 'resolved') { setLocationStatus(tr('explorar.location.unresolved'), 'location_off', 'warning'); return; }
          const countryCode = data.location.countryCode;
          const city = data.location.city;
          const hasManaged = (data.managed && data.managed.length > 0);
          const hasPublic = (data.publicInfo && data.publicInfo.length > 0);

          filterLocationCards(countryCode);
          renderLocationResults(data);

          if (hasManaged || hasPublic) {
            const sourceLabel = data.publicInfo?.[0]?.sourceName ? tr('explorar.location.source_via', { source: data.publicInfo[0].sourceName }) : '';
            const msg = city ? tr('explorar.location.available_city', { place: city, source: sourceLabel }) : (countryCode === 'MX' ? tr('explorar.location.available_mx', { source: sourceLabel }) : tr('explorar.location.available_country', { code: countryCode, source: sourceLabel }));
            setLocationStatus(msg, 'check_circle', 'success');
          } else {
            const msg = city ? tr('explorar.location.unavailable_place', { place: city }) : tr('explorar.location.unavailable_region', { code: countryCode });
            setLocationStatus(msg, 'location_off', 'warning');
          }
        } catch { setLocationStatus(tr('explorar.location.error'), 'signal_wifi_off', 'warning'); }
      }, () => {
        // Location permission was denied or unavailable
        setLocationStatus(tr('explorar.location.denied'), 'location_off', 'warning');
        updateList();
      }, { timeout: 8000, maximumAge: 300000 });
    }
    applyI18n();
    updateList();
    requestExploreLocation();

    function updateList() {
      let totalVisibleCount = 0;

    sections.forEach((section) => {
      const sectionCategory = section.dataset.category || '';
      const renderCats = (section.dataset.renderCategories || sectionCategory).split(',');
      const cards = section.querySelectorAll<HTMLElement>('.exp-card');
      let visibleCardsInSection = 0;

      cards.forEach((card) => {
        const title = card.querySelector('h2, h3')?.textContent?.toLowerCase() || '';
        const desc = card.getAttribute('data-desc')?.toLowerCase() || card.querySelector('p')?.textContent?.toLowerCase() || '';

        const matchesCategory = activeCategory === 'todos' || renderCats.includes(activeCategory);
        const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery);

        const cardCountry = (card.dataset.country || '').toUpperCase();
        const matchesCountry = cardCountry ? activeCountry === cardCountry : true;
        const isVisible = matchesCategory && matchesSearch && matchesCountry;
        card.classList.toggle('hidden-card', !isVisible);
        if (isVisible) {
          visibleCardsInSection++;
        }
      });

      // Si la categoría activa no aplica a esta sección, o si no hay cartas visibles, ocultamos la sección
      const isSectionVisible = (activeCategory === 'todos' || renderCats.includes(activeCategory)) && (visibleCardsInSection > 0);
      section.classList.toggle('hidden-section', !isSectionVisible);

      totalVisibleCount += visibleCardsInSection;
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', totalVisibleCount > 0);
      emptyState.classList.toggle('flex', totalVisibleCount === 0);
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const alreadyActive = chip.getAttribute('aria-pressed') === 'true';
      chips.forEach((c) => {
        c.setAttribute('aria-pressed', 'false');
        c.classList.remove('shadow-sm');
      });
      if (alreadyActive && chip.dataset.filter !== 'todos') {
        // Toggle off: vuelve a "Todos"
        activeCategory = 'todos';
        const todosChip = document.querySelector<HTMLButtonElement>('[data-filter="todos"]');
        todosChip?.setAttribute('aria-pressed', 'true');
      } else {
        chip.setAttribute('aria-pressed', 'true');
        chip.classList.add('shadow-sm');
        activeCategory = chip.dataset.filter ?? 'todos';
      }
      updateList();
    });
  });

  const suggestionsEl = document.getElementById('explore-search-suggestions');
  let activeSuggestionIndex = -1;

  function setExploreClearVisible(visible: boolean) {
    searchClear?.classList.toggle('hidden', !visible);
    searchClear?.classList.toggle('flex', visible);
  }

  function closeSuggestions() {
    if (suggestionsEl) {
      suggestionsEl.classList.add('hidden');
      suggestionsEl.innerHTML = '';
    }
    activeSuggestionIndex = -1;
  }

  function highlightSuggestion(items: NodeListOf<HTMLButtonElement>, index: number) {
    items.forEach((item, idx) => {
      if (idx === index) {
        item.classList.add('bg-slate-150', 'dark:bg-slate-800');
        item.focus();
      } else {
        item.classList.remove('bg-slate-150', 'dark:bg-slate-800');
      }
    });
  }

  function handleSelectSuggestion(id: string, type: 'tour' | 'monument' | 'experience', name: string) {
    closeSuggestions();
    
    if (searchInput) {
      searchInput.value = name;
      setExploreClearVisible(true);
      searchQuery = name.toLowerCase().trim();
      updateList();
    }

    // Attempt to locate card and scroll/highlight
    const card = document.querySelector(`[data-id="${id}"], [data-tour-id="${id}"]`);
    if (card) {
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      // Temporary highlight animation
      card.classList.add('ring-4', 'ring-brand-500/55', 'scale-[1.02]');
      setTimeout(() => {
        card.classList.remove('ring-4', 'ring-brand-500/55', 'scale-[1.02]');
      }, 2000);
    } else if (type === 'monument') {
      // Redirect to the map view zoomed on the monument
      navigate(`/mapa?placeId=${id}`);
    }
  }

  if (searchInput) {
    searchClear?.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      setExploreClearVisible(false);
      closeSuggestions();
      updateList();
      searchInput.focus();
    });

    searchInput.addEventListener('keydown', (e) => {
      if (!suggestionsEl || suggestionsEl.classList.contains('hidden')) return;
      const items = suggestionsEl.querySelectorAll<HTMLButtonElement>('button.suggestion-item');
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeSuggestionIndex = (activeSuggestionIndex + 1) % items.length;
        highlightSuggestion(items, activeSuggestionIndex);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeSuggestionIndex = (activeSuggestionIndex - 1 + items.length) % items.length;
        highlightSuggestion(items, activeSuggestionIndex);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeSuggestionIndex >= 0 && items[activeSuggestionIndex]) {
          items[activeSuggestionIndex].click();
        }
      } else if (e.key === 'Escape') {
        closeSuggestions();
      }
    });

    searchInput.addEventListener('focus', () => {
      if (searchInput.value.trim()) {
        searchInput.dispatchEvent(new Event('input'));
      }
    });

    searchInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      setExploreClearVisible(Boolean((e.target as HTMLInputElement).value));
      searchQuery = q;
      updateList();

      if (!q) {
        closeSuggestions();
        return;
      }

      const locale = detectLocale();

      // 1) Filter local monuments matching search query
      const monumentMatches = MONUMENTS.filter(m => {
        const name = pickLocalized(m, 'name', locale).toLowerCase();
        const desc = pickLocalized(m, 'desc', locale).toLowerCase();
        const cat = pickLocalized(m, 'category', locale).toLowerCase();
        return name.includes(q) || desc.includes(q) || cat.includes(q);
      }).slice(0, 4);

      // 2) Filter tours matching search query
      const tourMatches = TOURS.filter(t => {
        const title = pickLocalized(t, 'title', locale).toLowerCase();
        const desc = pickLocalized(t, 'description', locale).toLowerCase();
        const highlights = (t.highlights || []).join(' ').toLowerCase();
        return title.includes(q) || desc.includes(q) || highlights.includes(q);
      }).slice(0, 4);

      if (monumentMatches.length === 0 && tourMatches.length === 0) {
        if (suggestionsEl) {
          suggestionsEl.innerHTML = `<div class="p-4 text-center text-xs text-slate-400 dark:text-slate-500">${tr('explorar.search.no_suggestions')}</div>`;
          suggestionsEl.classList.remove('hidden');
        }
        return;
      }

      let suggestionsHtml = '<div class="py-1.5">';

      if (tourMatches.length > 0) {
        suggestionsHtml += `
          <div>
            <div class="text-[9px] font-bold text-accent-600 dark:text-accent-400 uppercase tracking-wider px-3.5 py-1 select-none">
              ${tr('explorar.search.suggested_tours')}
            </div>
            <div class="flex flex-col">
        `;
        tourMatches.forEach(t => {
          const title = pickLocalized(t, 'title', locale);
          const desc = pickLocalized(t, 'description', locale);
          suggestionsHtml += `
            <button
              type="button"
              class="suggestion-item w-full flex items-center gap-3 px-3.5 py-2 hover:bg-slate-100/70 dark:hover:bg-slate-800/60 transition-all text-left group outline-none focus:bg-slate-150 dark:focus:bg-slate-800"
              data-id="${t.id}"
              data-type="tour"
              data-name="${title.replace(/"/g, '&quot;')}"
            >
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 text-lg group-hover:scale-105 transition-transform">
                🎟️
              </span>
              <div class="min-w-0 flex-grow">
                <p class="truncate text-[12px] font-bold text-slate-800 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">${title}</p>
                <p class="truncate text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">${desc}</p>
              </div>
            </button>
          `;
        });
        suggestionsHtml += `</div></div>`;
      }

      if (monumentMatches.length > 0) {
        const borderClass = tourMatches.length > 0 ? 'border-t border-slate-200/50 dark:border-slate-800/50 mt-1.5 pt-1.5' : '';
        suggestionsHtml += `
          <div class="${borderClass}">
            <div class="text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider px-3.5 py-1 select-none">
              ${tr('explorar.search.suggested_places')}
            </div>
            <div class="flex flex-col">
        `;
        monumentMatches.forEach(m => {
          const name = pickLocalized(m, 'name', locale);
          const desc = pickLocalized(m, 'desc', locale);
          suggestionsHtml += `
            <button
              type="button"
              class="suggestion-item w-full flex items-center gap-3 px-3.5 py-2 hover:bg-slate-100/70 dark:hover:bg-slate-800/60 transition-all text-left group outline-none focus:bg-slate-150 dark:focus:bg-slate-800"
              data-id="${m.id}"
              data-type="monument"
              data-name="${name.replace(/"/g, '&quot;')}"
            >
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 text-lg group-hover:scale-105 transition-transform">
                ${m.emoji || '🏛️'}
              </span>
              <div class="min-w-0 flex-grow">
                <p class="truncate text-[12px] font-bold text-slate-800 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">${name}</p>
                <p class="truncate text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">${desc}</p>
              </div>
            </button>
          `;
        });
        suggestionsHtml += `</div></div>`;
      }

      suggestionsHtml += '</div>';

      if (suggestionsEl) {
        suggestionsEl.innerHTML = suggestionsHtml;
        suggestionsEl.classList.remove('hidden');

        const items = suggestionsEl.querySelectorAll<HTMLButtonElement>('button.suggestion-item');
        items.forEach(item => {
          item.addEventListener('click', () => {
            const id = item.getAttribute('data-id') || '';
            const type = (item.getAttribute('data-type') || 'experience') as 'tour' | 'monument' | 'experience';
            const name = item.getAttribute('data-name') || '';
            handleSelectSuggestion(id, type, name);
          });
        });
      }
      activeSuggestionIndex = -1;
    });
  }

  // Click outside to close
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (searchInput && !searchInput.contains(target) && suggestionsEl && !suggestionsEl.contains(target)) {

          <span class="material-symbols-outlined text-4xl text-emerald-600 dark:text-emerald-400">check_circle</span>
          <h3 class="ios-text-title3 text-emerald-900 dark:text-emerald-200" data-i18n="explorar.tour.success_title">¡Solicitud enviada!</h3>

                            href={exp.videoUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="absolute top-3 right-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br from-accent-500 to-accent-700 text-white shadow-md backdrop-blur-md transition-all hover:from-accent-600 hover:to-accent-800 active:scale-95"

---
import Layout from '../layouts/Layout.astro';
import UnifiedSearchBar from '../components/UnifiedSearchBar.astro';
import AiAgent from '../components/AiAgent.astro';
import { MONUMENTS } from '../data/monuments';
import type { Tour } from '../data/tours';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import esDict from '../i18n/es.json';
import enDict from '../i18n/en.json';

type TourRow = {
  id: string; title: string; subtitle: string; duration: string;
  price_per_person: number; currency: string; image: string; highlights: string;
  description: string; meeting_point: string; city: string; country: string;
  country_code?: string | null;
  guide: string; category: string; translations: string; is_published: number;
};
type ExploreTour = Tour & { countryCode: string };
function __normalizeCountryCode(countryCode: string | null | undefined, legacyCountry: string): string {
  const normalized = countryCode?.trim().toUpperCase() || '';
  if (/^[A-Z]{2}$/.test(normalized)) return normalized;
  const legacyNormalized = legacyCountry.trim().toUpperCase();
  return ['MX', 'MEXICO', 'MÉXICO'].includes(legacyNormalized) ? 'MX' : '';
}
function __parseTourJson<T>(raw: string, fallback: T): T {
  try {
    return (JSON.parse(raw || 'null') ?? fallback) as T;
  } catch {
    return fallback;
  }
}
let TOURS: ExploreTour[] = [];
try {
  const _toursResult = await Astro.locals.runtime.env.DB
    .prepare('SELECT * FROM tours WHERE is_published = 1 ORDER BY created_at DESC')
    .all();
  TOURS = ((_toursResult?.results as TourRow[]) ?? []).map((r) => ({
    id: r.id,
    title: r.title,
    subtitle: r.subtitle,
    duration: r.duration,
    pricePerPerson: r.price_per_person,
    currency: r.currency,
    image: r.image,
    highlights: __parseTourJson<string[]>(r.highlights, []),
    description: r.description,
    meetingPoint: r.meeting_point,
    city: r.city,
    country: r.country,
    countryCode: __normalizeCountryCode(r.country_code, r.country),
    guide: __parseTourJson<{ name: string; title: string; bio: string }>(r.guide, { name: '', title: '', bio: '' }),
    category: (r.category || 'tour') as Tour['category'],
    translations: __parseTourJson<Tour['translations']>(r.translations, undefined),
  }));
} catch (err) {
  console.warn('[explorar.astro] DB tours query failed, using static fallback:', err);
}

type Category = 'todos' | 'turismo' | 'patrimonio' | 'cultura' | 'gastronomia' | 'museo' | 'sitio-remoto' | 'eventos' | 'educacion';

interface Experience {
  id: string;
  title: string;
  description: string;
  image: string;
  category: Exclude<Category, 'todos'>;
  tagColor: 'emerald' | 'accent' | 'amber' | 'rose' | 'sky' | 'blue';
  url: string;
  cta: string;
  rating?: number;
  reviewCount?: number;
  price?: string;
  images?: string[];
  sku?: string;
  videoUrl?: string;
  isVRAvailable?: boolean;
  meetingPoint?: string;
  customBadge?: string;
  currency?: string;
  duration?: string;
  highlights?: string[];
  isTour?: boolean;
  lat?: number;
  lng?: number;
  translations?: {
    es: { name: string; desc: string; category: string; cta: string; guide: string };
    en: { name: string; desc: string; category: string; cta: string; guide: string };
    señas: { name: string; desc: string; category: string; cta: string; guide: string; videoUrl: string };
    native?: { name: string; desc: string; category: string; cta: string; guide: string };
  };
}


                          src={optimizeImageUrl(exp.image, 450, 75)}
                          alt={exp.title}
                          loading={catIdx === 0 && expIdx < 2 ? "eager" : "lazy"}
                          fetchpriority={catIdx === 0 && expIdx === 0 ? "high" : undefined}
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        {/* VR Badge: aparece arriba a la derecha cuando hay experiencia VR */}
                        {exp.isVRAvailable && exp.videoUrl && (

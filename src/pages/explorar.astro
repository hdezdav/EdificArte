      'border-emerald-200/50 bg-emerald-50 text-emerald-700 dark:border-emerald-800/50 dark:bg-emerald-950/40 dark:text-emerald-400',
    pill: 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-400',
  },
  accent: {
    badge:
      'border-accent-200/50 bg-accent-50 text-accent-700 dark:border-accent-800/50 dark:bg-accent-950/40 dark:text-accent-400',
    pill: 'border-accent-200 bg-accent-50 text-accent-700 dark:border-accent-800 dark:bg-accent-950/30 dark:text-accent-400',
  },
  amber: {
    badge:
      'border-amber-200/50 bg-amber-50 text-amber-700 dark:border-amber-800/50 dark:bg-amber-950/40 dark:text-amber-400',
    pill: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-400',
  },
  rose: {
    badge:
      'border-rose-200/50 bg-rose-50 text-rose-700 dark:border-rose-800/50 dark:bg-rose-950/40 dark:text-rose-400',
    pill: 'border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-400',
  },
  sky: {
    badge:
      'border-purple-200/50 bg-purple-50 text-purple-700 dark:border-purple-800/50 dark:bg-purple-950/40 dark:text-purple-400',
    pill: 'border-purple-200 bg-purple-50 text-purple-700 dark:border-purple-800 dark:bg-purple-950/30 dark:text-purple-400',
  },
  blue: {
    badge:
      'border-violet-200/50 bg-violet-50 text-violet-700 dark:border-violet-800/50 dark:bg-violet-950/40 dark:text-violet-400',
    pill: 'border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800 dark:bg-violet-950/30 dark:text-violet-400',
  },
};

// Orden visual de los chips (izquierda → derecha) y de las secciones
// en el feed. La sección 'sitio-remoto' absorbe también las experiencias
// con category 'patrimonio' y 'cultura' (ver categorias.map); ambas se
// mantienen como filtros de chip pero no renderizan secciones propias
// para evitar duplicados.
const categoryLabel: Record<Category, string> = {
  todos: 'Todos',
  turismo: 'Turismo',
  'sitio-remoto': 'Sitios Turísticos',
  patrimonio: 'Patrimonio',
  cultura: 'Cultura',
  museo: 'Museos',
  gastronomia: 'Gastronomía',
  eventos: 'Eventos / Exposiciones',
  educacion: 'Educación y Ciencia',
};

const categories: Exclude<Category, 'todos'>[] = [
  'turismo',
  'sitio-remoto',
  'museo',
  'educacion',
  'gastronomia',
  'eventos',
];

// Helper: convierte un Tour en Experience para mezclarlo en el carousel de Turismo
function toExperience(tour: Tour): Experience {
  return {
    id: tour.id,
    title: tour.title,
    description: tour.description,
    image: tour.image,
    category: 'turismo',
    tagColor: 'accent',
    url: '#',
    cta: 'Reservar',
    rating: 4.98,
    reviewCount: 67,
    price: `$${tour.pricePerPerson} MXN`,
    highlights: tour.highlights,
    meetingPoint: tour.meetingPoint,
    currency: tour.currency,
    duration: tour.duration,
    isTour: true,
  };
}

function optimizeImageUrl(url: string, width: number = 400, quality: number = 75): string {
  if (!url) return '';
  if (url.includes('unsplash.com')) {
    try {
      const u = new URL(url);
      u.searchParams.set('w', String(width));
      u.searchParams.set('q', String(quality));
      u.searchParams.set('fit', 'crop');
      u.searchParams.set('auto', 'format');
      return u.toString();
    } catch {
      return url;
    }
  }
  return url;
}

const locale = (Astro.currentLocale as Locale) || DEFAULT_LOCALE;
const dict = locale === 'es' ? esDict : enDict;

const paymentAddress = ((Astro.locals?.runtime?.env as unknown as { EDIFICARTE_PAYMENT_ADDRESS?: string; TURIMAP_PAYMENT_ADDRESS?: string })?.EDIFICARTE_PAYMENT_ADDRESS || (Astro.locals?.runtime?.env as unknown as { TURIMAP_PAYMENT_ADDRESS?: string })?.TURIMAP_PAYMENT_ADDRESS);
---

<Layout title={`EdificARTE - ${dict.nav.explore}`} locale={locale}>
  <script is:inline define:vars={{ paymentAddress }}>
    window.__EDIFICARTE_PAYMENT_ADDRESS__ = paymentAddress || '';
    window.__TURIMAP_PAYMENT_ADDRESS__ = paymentAddress || '';
  </script>
  <script is:inline define:vars={{ experiencesMap: Object.fromEntries(todasLasExperiencias.map(e => [e.id, { title: e.title, image: e.image, category: e.category }])) }}>
    window.__EDIFICARTE_EXPERIENCES__ = experiencesMap;
    window.__TURIMAP_EXPERIENCES__ = experiencesMap;
  </script>
  <script is:inline define:vars={{ toursData: TOURS }}>
    window.__EDIFICARTE_TOURS__ = toursData || [];
    window.__TURIMAP_TOURS__ = toursData || [];
  </script>
  <script is:inline define:vars={{ monumentsList: MONUMENTS.map(m => ({ id: m.id, name: m.name, lat: m.lat, lng: m.lng, image: m.image })) }}>
    // For proximity notifications in Layout.astro
    window.__EDIFICARTE_MONUMENTS__ = monumentsList;
    window.__TURIMAP_MONUMENTS__ = monumentsList;
  </script>


  <div class="unified-search-layer">
    <UnifiedSearchBar
      inputId="explore-search-input"
      clearId="explore-search-clear"
      suggestionsId="explore-search-suggestions"
      placeholder="Buscar experiencias, patrimonio, cultura..."
      ariaLabel="Buscar experiencias, patrimonio, cultura"
      i18nPlaceholder="explore.search_placeholder"
    />
  </div>

  <div class="unified-search-spacer" aria-hidden="true"></div>

  <div class="flex flex-col gap-7">
    <!-- Hero -->
    <header class="text-center pt-4 pb-2">
      <h1 class="text-[2.1rem] sm:text-[2.6rem] font-bold tracking-tight leading-[1.15] text-slate-900 dark:text-white mb-3" data-i18n-html="explorar.hero.title">
        Encuentra tu próxima<br>
        experiencia
      </h1>
      <p class="text-[14px] sm:text-[15px] text-slate-500 dark:text-slate-400 max-w-xs sm:max-w-sm mx-auto mb-6 leading-relaxed" data-i18n="explorar.hero.subtitle">
        Cultura, patrimonio y lugares únicos cerca de ti.
      </p>
      <div id="explore-location-status" role="status" aria-live="polite" class="explore-location-pill inline-flex items-center gap-2 px-4 py-2 text-[11px] font-medium transition-colors duration-300">
        <span id="explore-location-icon" class="material-symbols-outlined text-[15px] shrink-0 text-slate-500 dark:text-slate-400">near_me</span>
        <span id="explore-location-text" data-i18n="explorar.location.detecting">Obteniendo ubicación…</span>
      </div>
      <div id="explore-public-info" class="hidden"></div>
    </header>

    <!-- Category Chips -->
    <div
      class="no-scrollbar -mx-4 flex gap-2.5 overflow-x-auto px-4 pb-1 sm:mx-0 sm:justify-center sm:px-0"
      role="tablist"
      aria-label="Filtrar por categoría"
      data-i18n-attr="aria-label|explorar.a11y.filter_category"
    >
      {
        (Object.keys(categoryLabel) as Category[]).map((cat) => (
          <button
            type="button"
            data-filter={cat}
            data-i18n={`explorar.categories.${cat.replace('-', '_')}`}
            class="filter-chip rounded-full border px-4 py-2.5 text-[12px] font-semibold transition-all active:scale-95"
            aria-pressed={cat === 'todos' ? 'true' : 'false'}
          >
            {categoryLabel[cat]}
          </button>
        ))
      }
    </div>

    <!-- Experience Sections (Horizontal Carousels) -->
    <div id="experiences-sections-container" class="flex flex-col gap-6">
      {
        categories.map((cat, catIdx) => {
          const catExp = cat === 'turismo'
            ? [...todasLasExperiencias.filter(exp => exp.category === cat), ...TOURS.map(toExperience)]
            : cat === 'sitio-remoto'
              ? todasLasExperiencias.filter(exp => exp.category === 'sitio-remoto' || exp.category === 'cultura' || exp.category === 'patrimonio')
              : todasLasExperiencias.filter(exp => exp.category === cat);
          if (catExp.length === 0 && cat !== 'educacion') return null;

          return (
            <section
              data-category={cat}
              data-render-categories={cat === 'sitio-remoto' ? "sitio-remoto,cultura,patrimonio" : cat}
              class="category-section w-full py-2 border-b border-slate-100/60 dark:border-slate-800/60 last:border-0"
            >
              <div class="mb-3 flex items-center justify-between">
                <h2 class="font-bold text-base md:text-lg tracking-tight text-slate-800 dark:text-slate-100 flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-brand-500"></span>
                  <span data-i18n={`explorar.categories.${cat.replace('-', '_')}`}>{categoryLabel[cat]}</span>
                </h2>
                <div class="flex items-center gap-1.5">
                  <button
                    type="button"
                    class="scroll-left-btn h-7 w-7 rounded-full border border-slate-200 dark:border-slate-800/50 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center transition-colors active:scale-90"

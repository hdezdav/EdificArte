                          data-i18n-attr="title|explorar.a11y.favorite_add"
                        >
                          <svg class="h-4 w-4 fill-none stroke-current stroke-[2px]" viewBox="0 0 24 24">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                          </svg>
                        </button>
                        <span
                          class={`absolute top-3 left-3 rounded-lg px-2 py-0.5 font-bold text-[10px] uppercase tracking-wider backdrop-blur-md border ${tagStyles[exp.tagColor].badge}`}
                          data-i18n={exp.customBadge ? undefined : `explorar.categories.${exp.category.replace('-', '_')}`}
                        >
                          {exp.customBadge ?? categoryLabel[exp.category]}
                        </span>
                      </div>

                      {/* Body */}
                      <div class="flex flex-1 flex-col justify-between p-4 bg-white dark:bg-slate-900">
                        <div>
                          <h2 class="text-sm font-bold tracking-tight text-slate-800 dark:text-slate-100 line-clamp-1 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                            {exp.title}
                          </h2>
                          <p class="text-slate-500 dark:text-slate-400 text-xs tracking-tight mt-1.5 line-clamp-2 leading-relaxed">
                            {exp.description}
                          </p>
                        </div>

                        {/* Highlights (solo para tours) */}
                        {exp.isTour && exp.highlights && (
                          <div class="px-3 pt-2 pb-1 flex flex-wrap gap-1">
                            {exp.highlights.slice(0, 2).map((h) => (
                              <span class="text-[9px] bg-brand-50 text-brand-700 px-1.5 py-0.5 rounded-full border border-brand-200/50 font-semibold">
                                {h.length > 30 ? h.substring(0, 30) + '…' : h}
                              </span>
                            ))}
                          </div>
                        )}

                        {/* Footer */}
                        <div class="mt-auto pt-3 flex items-center gap-1.5 text-[11px] font-semibold text-slate-700 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800/60">
                          {exp.rating && (
                            <span class="flex items-center gap-0.5 text-amber-500">
                              <span class="material-symbols-outlined text-[14px] !font-bold">star</span>
                              <span class="text-slate-800 dark:text-slate-200">{exp.rating.toFixed(2)}</span>
                            </span>
                          )}
                          {exp.reviewCount && (
                            <span class="text-slate-400 dark:text-slate-500 font-normal">
                              ({exp.reviewCount})
                            </span>
                          )}
                          {exp.price && (
                            <span class="text-slate-400 dark:text-slate-500 font-normal ml-0.5">
                              · {exp.price}
                            </span>
                          )}

                          {
                            exp.isTour ? (
                              <button
                                type="button"
                                class="ml-auto inline-flex items-center gap-1 rounded-xl bg-gradient-to-r from-accent-600 to-accent-700 hover:from-accent-700 hover:to-accent-800 text-white font-bold px-3 py-1.5 text-[11px] shadow-sm transition-all active:scale-[0.97] tour-reserve-btn"
                              >
                                <span class="material-symbols-outlined text-[12px]">event_available</span>
                                {exp.cta}
                              </button>
                            ) : exp.translations ? (
                              <button
                                type="button"
                                class="ml-auto inline-flex items-center gap-1 rounded-xl bg-brand-50 hover:bg-brand-100 dark:bg-brand-950/20 dark:hover:bg-brand-950/40 text-brand-600 dark:text-brand-400 font-bold px-3 py-1.5 text-[11px] shadow-sm transition-all active:scale-[0.97] guide-trigger-btn"
                              >
                                {exp.cta}
                                <span class="material-symbols-outlined text-[12px] transition-transform duration-200 group-hover:translate-x-0.5">arrow_forward</span>
                              </button>
                            ) : (
                              <a
                                href={exp.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="ml-auto inline-flex items-center gap-1 rounded-xl bg-brand-50 hover:bg-brand-100 dark:bg-brand-950/20 dark:hover:bg-brand-950/40 text-brand-600 dark:text-brand-400 font-bold px-3 py-1.5 text-[11px] shadow-sm transition-all active:scale-[0.97]"
                              >
                                {exp.cta}
                                <span class="material-symbols-outlined text-[12px] transition-transform duration-200 group-hover:translate-x-0.5">arrow_forward</span>
                              </a>
                            )
                          }
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
            </section>
          );
        })
      }




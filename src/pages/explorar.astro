  >
    <div class="ios-backdrop absolute inset-0" data-tour-modal-dismiss></div>
    <div
      class="ios-modal relative mx-auto flex w-full flex-col overflow-hidden sm:max-w-lg"
      style="max-height: 92dvh;"
    >
      <header class="flex items-start justify-between gap-3 border-b border-slate-200/60 px-5 sm:px-6 pb-4 pt-5 dark:border-slate-700/60">
        <div class="min-w-0 flex-1">

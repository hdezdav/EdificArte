---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/admin';

const loggedIn = isAdmin(Astro.locals);
if (!loggedIn) return Astro.redirect('/admin/login');

const env = Astro.locals.runtime.env;
const mask = (s: string | undefined) => s ? s.slice(0, 4) + '••••' + s.slice(-4) : 'No configurado';

const settings = [
  { label: 'AI_API_KEY', value: mask(env.AI_API_KEY || env.GROK_API_KEY), category: 'AI' },
  { label: 'MAPBOX_TOKEN', value: mask(env.MAPBOX_TOKEN), category: 'Mapas' },
  { label: 'TURIMAP_PAYMENT_ADDRESS', value: mask(env.TURIMAP_PAYMENT_ADDRESS), category: 'Pagos' },
  { label: 'TURIMAP_DONATION_ADDRESS', value: mask(env.TURIMAP_DONATION_ADDRESS), category: 'Pagos' },
  { label: 'USDC_CONTRACT_ADDRESS', value: mask(env.USDC_CONTRACT_ADDRESS), category: 'Blockchain' },
  { label: 'ALCHEMY_KEY', value: mask(env.ALCHEMY_KEY), category: 'Blockchain' },
];
---
<AdminLayout title="Configuración" activePage="settings">
  <div class="max-w-2xl space-y-6">
    <!-- Environment Variables -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-800">
        <h2 class="text-sm font-bold text-white">Variables de Entorno</h2>
        <p class="text-xs text-slate-500 mt-0.5">Valores actuales (secrets enmascarados)</p>
      </div>
      <div class="divide-y divide-slate-800/60">
        {settings.map((s) => (
          <div class="flex items-center gap-4 px-5 py-3">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-mono font-semibold text-white">{s.label}</p>
              <p class="text-[10px] text-slate-500 uppercase tracking-wider">{s.category}</p>
            </div>
            <code class="rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-mono text-slate-400">{s.value}</code>
          </div>
        ))}
      </div>
    </div>

    <!-- Database Info -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-800">
        <h2 class="text-sm font-bold text-white">Base de Datos</h2>
      </div>
      <div class="p-5 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-400">Motor</span>
          <span class="text-sm font-semibold text-white">SQLite (D1 Mock)</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-400">Tablas</span>
          <span class="text-sm font-semibold text-white">users, orders, reviews, user_badges, user_wallets, kv_sessions</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-400">Entorno</span>
          <span class:list={["px-2 py-0.5 rounded-lg text-xs font-bold", import.meta.env.PROD ? "bg-emerald-500/15 text-emerald-400" : "bg-amber-500/15 text-amber-400"]}>
            {import.meta.env.PROD ? 'Producción' : 'Desarrollo'}
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-800">
        <h2 class="text-sm font-bold text-white">Enlaces útiles</h2>
      </div>
      <div class="p-5 space-y-2">
        <a href="/" class="flex items-center gap-2 text-sm text-purple-400 hover:text-purple-300 transition-colors">
          <span class="material-symbols-outlined text-[18px]">open_in_new</span>
          Ver sitio público
        </a>
        <a href="/admin" class="flex items-center gap-2 text-sm text-purple-400 hover:text-purple-300 transition-colors">
          <span class="material-symbols-outlined text-[18px]">dashboard</span>
          Volver al Dashboard
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

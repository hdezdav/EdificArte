---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/admin';

const loggedIn = isAdmin(Astro.locals);
if (!loggedIn) return Astro.redirect('/admin/login');
---
<AdminLayout title="Productos" activePage="products">
  <!-- Header -->
  <div class="mb-6 flex items-center justify-between gap-4">
    <div class="relative max-w-md flex-1">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-slate-500">search</span>
      <input
        type="text"
        id="product-search"
        placeholder="Buscar por nombre, SKU o categoría..."
        class="w-full rounded-xl border border-slate-700 bg-slate-800/50 pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all"
      />
    </div>
    <button id="new-product-btn" class="flex items-center gap-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold px-4 py-2.5 text-sm transition-all active:scale-[0.98] shadow-lg shadow-purple-600/20">
      <span class="material-symbols-outlined text-[18px]">add</span>
      Nuevo
    </button>
  </div>

  <!-- Table -->
  <div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-800 text-left">
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Nombre</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">SKU</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Precio</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Categoría</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Origen</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Publicado</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Acciones</th>
          </tr>
        </thead>
        <tbody id="products-tbody" class="divide-y divide-slate-800/60">
          <tr><td colspan="7" class="px-5 py-8 text-center text-slate-600">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
    <div id="products-pagination" class="flex items-center justify-between px-5 py-3 border-t border-slate-800">
      <p id="products-count" class="text-xs text-slate-500"></p>
      <div class="flex gap-2">
        <button id="products-prev" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-all disabled:opacity-30" disabled>‹ Anterior</button>
        <button id="products-next" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-all disabled:opacity-30" disabled>Siguiente ›</button>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div id="product-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-5">
        <h2 id="product-modal-title" class="text-lg font-bold text-white">Nuevo producto</h2>
        <button id="product-modal-close" class="p-1.5 rounded-lg text-slate-500 hover:text-white hover:bg-slate-800 transition-all">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
      <form id="product-form" class="space-y-4">
        <input type="hidden" id="product-id" />
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Nombre *</label>
          <input type="text" id="product-name" required class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Descripción</label>
          <textarea id="product-description" rows="3" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">SKU</label>
            <input type="text" id="product-sku" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Precio</label>
            <input type="number" id="product-price" min="0" step="1" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
          </div>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Moneda</label>
            <input type="text" id="product-currency" value="MXN" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Categoría</label>
            <input type="text" id="product-category" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
          </div>
          <div>
            <label for="product-country-code" class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Country code (ISO alpha-2)</label>
            <input type="text" id="product-country-code" maxlength="2" placeholder="MX" aria-describedby="product-country-help" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
            <p id="product-country-help" class="mt-1 text-[11px] text-slate-500">Used for country-level Explore matching.</p>
            <label for="product-origin" class="mt-3 block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Legacy origin</label>
            <input type="text" id="product-origin" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Imágenes (una URL por línea)</label>
          <textarea id="product-images" rows="3" placeholder="https://..." class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wider">Archivo / URL</label>
          <input type="text" id="product-file" class="w-full rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all" />
        </div>
        <label class="flex items-center gap-2.5 cursor-pointer">
          <input type="checkbox" id="product-published" checked class="h-4 w-4 rounded border-slate-700 bg-slate-800 text-purple-600 focus:ring-purple-500/20" />
          <span class="text-sm text-slate-300">Publicado</span>
        </label>
        <div id="product-error" class="hidden rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-2.5 text-sm text-red-400"></div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="product-cancel" class="rounded-xl border border-slate-700 text-slate-300 hover:text-white hover:bg-slate-800 font-semibold px-4 py-2.5 text-sm transition-all">Cancelar</button>
          <button type="submit" id="product-save" class="rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold px-4 py-2.5 text-sm transition-all active:scale-[0.98]">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let currentPage = 1;
    let currentSearch = '';
    const limit = 20;
    let editingId: string | null = null;
    let lastProducts: any[] = [];

    const modal = document.getElementById('product-modal')!;
    const form = document.getElementById('product-form') as HTMLFormElement;
    const errorEl = document.getElementById('product-error')!;

    function openModal(product?: any) {
      editingId = product?.id ?? null;
      document.getElementById('product-modal-title')!.textContent = product ? 'Editar producto' : 'Nuevo producto';
      document.getElementById('product-id')!.setAttribute('value', product?.id ?? '');
      (document.getElementById('product-name') as HTMLInputElement).value = product?.name ?? '';
      (document.getElementById('product-description') as HTMLTextAreaElement).value = product?.description ?? '';
      (document.getElementById('product-sku') as HTMLInputElement).value = product?.sku ?? '';
      (document.getElementById('product-price') as HTMLInputElement).value = product?.price ?? '';
      (document.getElementById('product-currency') as HTMLInputElement).value = product?.currency ?? 'MXN';
      (document.getElementById('product-category') as HTMLInputElement).value = product?.category ?? '';
       (document.getElementById('product-origin') as HTMLInputElement).value = product?.origin ?? '';
       (document.getElementById('product-country-code') as HTMLInputElement).value = product?.countryCode ?? '';
      (document.getElementById('product-images') as HTMLTextAreaElement).value = (product?.images ?? []).join('\n');
      (document.getElementById('product-file') as HTMLInputElement).value = product?.file ?? '';
      (document.getElementById('product-published') as HTMLInputElement).checked = product ? product.is_published : true;
      errorEl.classList.add('hidden');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      editingId = null;
    }

    function collectBody() {
      const images = (document.getElementById('product-images') as HTMLTextAreaElement)
        .value.split('\n').map(s => s.trim()).filter(Boolean);
      return {
        name: (document.getElementById('product-name') as HTMLInputElement).value.trim(),
        description: (document.getElementById('product-description') as HTMLTextAreaElement).value.trim(),
        sku: (document.getElementById('product-sku') as HTMLInputElement).value.trim(),
        price: Number((document.getElementById('product-price') as HTMLInputElement).value || 0),
        currency: (document.getElementById('product-currency') as HTMLInputElement).value.trim() || 'MXN',
        category: (document.getElementById('product-category') as HTMLInputElement).value.trim(),
        origin: (document.getElementById('product-origin') as HTMLInputElement).value.trim(),
        countryCode: (document.getElementById('product-country-code') as HTMLInputElement).value.trim().toUpperCase(),
        images,
        file: (document.getElementById('product-file') as HTMLInputElement).value.trim(),
        is_published: (document.getElementById('product-published') as HTMLInputElement).checked,
      };
    }

    async function loadProducts() {
      const params = new URLSearchParams({ page: String(currentPage), limit: String(limit) });
      if (currentSearch) params.set('search', currentSearch);
      try {
        const res = await fetch(`/api/admin/products?${params}`);
        const data = await res.json();
        if (!data.ok) return;
        lastProducts = data.products ?? [];
        const tbody = document.getElementById('products-tbody')!;
        if (!data.products.length) {
          tbody.innerHTML = '<tr><td colspan="7" class="px-5 py-8 text-center text-slate-600">Sin resultados</td></tr>';
        } else {
          tbody.innerHTML = data.products.map((p: any) => `
            <tr class="hover:bg-slate-800/30 transition-colors">
              <td class="px-5 py-3 font-semibold text-white text-sm">${escapeHtml(p.name || '—')}</td>
              <td class="px-5 py-3 text-slate-400 text-sm font-mono">${escapeHtml(p.sku || '—')}</td>
              <td class="px-5 py-3 text-right"><span class="font-bold text-purple-400">${p.price ?? 0}</span> <span class="text-slate-500 text-xs">${escapeHtml(p.currency || '')}</span></td>
              <td class="px-5 py-3 text-slate-400 text-sm">${escapeHtml(p.category || '—')}</td>
              <td class="px-5 py-3 text-slate-400 text-sm">${escapeHtml(p.origin || '—')}</td>
              <td class="px-5 py-3">${p.is_published ? '<span class="text-emerald-400 text-xs font-semibold">Sí</span>' : '<span class="text-slate-500 text-xs">No</span>'}</td>
              <td class="px-5 py-3 text-right whitespace-nowrap">
                <button data-edit="${p.id}" class="edit-btn px-2 py-1 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all">Editar</button>
                <button data-delete="${p.id}" class="delete-btn px-2 py-1 rounded-lg text-xs font-semibold text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-all">Eliminar</button>
              </td>
            </tr>
          `).join('');
          tbody.querySelectorAll('.edit-btn').forEach(b => b.addEventListener('click', () => onEdit((b as HTMLElement).dataset.edit!)));
          tbody.querySelectorAll('.delete-btn').forEach(b => b.addEventListener('click', () => onDelete((b as HTMLElement).dataset.delete!)));
        }
        document.getElementById('products-count')!.textContent = `${data.total} producto(s) total`;
        (document.getElementById('products-prev') as HTMLButtonElement).disabled = currentPage <= 1;
        (document.getElementById('products-next') as HTMLButtonElement).disabled = currentPage * limit >= data.total;
      } catch {
        document.getElementById('products-tbody')!.innerHTML = '<tr><td colspan="7" class="px-5 py-8 text-center text-red-400">Error al cargar</td></tr>';
      }
    }

    function escapeHtml(s: string) {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    function onEdit(id: string) {
      const product = lastProducts.find((p: any) => p.id === id);
      if (product) openModal(product);
    }

    async function onDelete(id: string) {
      if (!confirm('¿Eliminar este producto?')) return;
      const res = await fetch('/api/admin/products', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
      const data = await res.json();
      if (data.ok) loadProducts();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      const body = collectBody();
      if (!body.name) { errorEl.textContent = 'El nombre es obligatorio'; errorEl.classList.remove('hidden'); return; }
      const method = editingId ? 'PATCH' : 'POST';
      const payload = editingId ? { ...body, id: editingId } : body;
      const res = await fetch('/api/admin/products', { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const data = await res.json();
      if (data.ok) { closeModal(); loadProducts(); }
      else { errorEl.textContent = data.error || 'Error al guardar'; errorEl.classList.remove('hidden'); }
    });

    document.getElementById('new-product-btn')?.addEventListener('click', () => openModal());
    document.getElementById('product-modal-close')?.addEventListener('click', closeModal);
    document.getElementById('product-cancel')?.addEventListener('click', closeModal);
    document.getElementById('product-search')?.addEventListener('input', (e) => { currentSearch = (e.target as HTMLInputElement).value; currentPage = 1; loadProducts(); });
    document.getElementById('products-prev')?.addEventListener('click', () => { currentPage--; loadProducts(); });
    document.getElementById('products-next')?.addEventListener('click', () => { currentPage++; loadProducts(); });

    loadProducts();
  </script>
</AdminLayout>

---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/admin';

const loggedIn = isAdmin(Astro.locals);
if (!loggedIn) return Astro.redirect('/admin/login');

const env = Astro.locals.runtime.env;

// Load stats server-side
let stats = { totalUsers: 0, totalOrders: 0, totalReviews: 0, totalRevenueUSDC: 0 };
let recentUsers: Array<{ id: string; name: string; email: string; points: number; visits: number; created_at: string }> = [];
let recentOrders: Array<{ id: string; wallet_address: string; total_usdc: string; status: string; created_at: string }> = [];

try {
  const [usersCount, ordersCount, reviewsCount, revenueRow, ru, ro] = await Promise.all([
    env.DB.prepare('SELECT COUNT(*) as count FROM users').first<{ count: number }>(),
    env.DB.prepare('SELECT COUNT(*) as count FROM orders').first<{ count: number }>(),
    env.DB.prepare('SELECT COUNT(*) as count FROM reviews').first<{ count: number }>(),
    env.DB.prepare("SELECT COALESCE(SUM(CAST(total_usdc AS REAL)), 0) as total FROM orders WHERE status = 'paid'").first<{ total: number }>(),
    env.DB.prepare('SELECT id, name, email, points, visits, created_at FROM users ORDER BY created_at DESC LIMIT 8').all(),
    env.DB.prepare('SELECT id, wallet_address, total_usdc, status, created_at FROM orders ORDER BY created_at DESC LIMIT 8').all(),
  ]);

  stats = {
    totalUsers: usersCount?.count ?? 0,
    totalOrders: ordersCount?.count ?? 0,
    totalReviews: reviewsCount?.count ?? 0,
    totalRevenueUSDC: revenueRow?.total ?? 0,
  };
  recentUsers = (ru?.results ?? []) as typeof recentUsers;
  recentOrders = (ro?.results ?? []) as typeof recentOrders;
} catch {}

function truncate(s: string, n: number) { return s.length > n ? s.slice(0, n) + '…' : s; }
function shortAddr(s: string) { return s && s.length > 12 ? s.slice(0, 6) + '…' + s.slice(-4) : s; }
function timeAgo(d: string) {
  const diff = Date.now() - new Date(d).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `hace ${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `hace ${hrs}h`;
  const days = Math.floor(hrs / 24);
  return `hace ${days}d`;
}
---
<AdminLayout title="Dashboard" activePage="dashboard">
  <!-- Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-9 w-9 rounded-xl bg-purple-500/15 flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px] text-purple-400">group</span>
        </div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Usuarios</span>
      </div>
      <p class="text-2xl font-extrabold text-white">{stats.totalUsers}</p>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-9 w-9 rounded-xl bg-emerald-500/15 flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px] text-emerald-400">receipt_long</span>
        </div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Órdenes</span>
      </div>
      <p class="text-2xl font-extrabold text-white">{stats.totalOrders}</p>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-9 w-9 rounded-xl bg-amber-500/15 flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px] text-amber-400">rate_review</span>
        </div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Reviews</span>
      </div>
      <p class="text-2xl font-extrabold text-white">{stats.totalReviews}</p>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-9 w-9 rounded-xl bg-violet-500/15 flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px] text-violet-400">payments</span>
        </div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Revenue USDC</span>
      </div>
      <p class="text-2xl font-extrabold text-white">${Number(stats.totalRevenueUSDC).toFixed(2)}</p>
    </div>
  </div>

  <div class="grid lg:grid-cols-2 gap-6">
    <!-- Recent Users -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-800">
        <h2 class="text-sm font-bold text-white">Usuarios recientes</h2>
        <a href="/admin/users" class="text-xs font-semibold text-purple-400 hover:text-purple-300 transition-colors">Ver todos →</a>
      </div>
      <div class="divide-y divide-slate-800/60">
        {recentUsers.map((u) => (
          <div class="flex items-center gap-3 px-5 py-3">
            <div class="h-8 w-8 rounded-full bg-slate-800 flex items-center justify-center text-xs font-bold text-slate-400 flex-shrink-0">
              {(u.name || '?').charAt(0).toUpperCase()}
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold text-white truncate">{u.name}</p>
              <p class="text-[11px] text-slate-500 truncate">{u.email}</p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-xs font-bold text-purple-400">{u.points} pts</p>
              <p class="text-[10px] text-slate-600">{timeAgo(u.created_at)}</p>
            </div>
          </div>
        ))}
        {recentUsers.length === 0 && (
          <p class="px-5 py-6 text-sm text-slate-600 text-center">Sin usuarios aún</p>
        )}
      </div>
    </div>

    <!-- Recent Orders -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-800">
        <h2 class="text-sm font-bold text-white">Órdenes recientes</h2>
        <a href="/admin/orders" class="text-xs font-semibold text-purple-400 hover:text-purple-300 transition-colors">Ver todas →</a>
      </div>
      <div class="divide-y divide-slate-800/60">
        {recentOrders.map((o) => (
          <div class="flex items-center gap-3 px-5 py-3">
            <div class:list={[
              "h-2 w-2 rounded-full flex-shrink-0",
              o.status === 'paid' ? "bg-emerald-400" : o.status === 'cancelled' ? "bg-red-400" : "bg-amber-400"
            ]}></div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold text-white font-mono">{truncate(o.id, 20)}</p>
              <p class="text-[11px] text-slate-500">{shortAddr(o.wallet_address)}</p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-xs font-bold text-emerald-400">${Number(o.total_usdc).toFixed(2)} USDC</p>
              <p class="text-[10px] text-slate-600">{o.status}</p>
            </div>
          </div>
        ))}
        {recentOrders.length === 0 && (
          <p class="px-5 py-6 text-sm text-slate-600 text-center">Sin órdenes aún</p>
        )}
      </div>
    </div>
  </div>
</AdminLayout>
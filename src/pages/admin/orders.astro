---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/admin';

const loggedIn = isAdmin(Astro.locals);
if (!loggedIn) return Astro.redirect('/admin/login');
---
<AdminLayout title="Órdenes" activePage="orders">
  <!-- Filters -->
  <div class="flex flex-wrap gap-2 mb-6">
    <button data-status="" class="order-filter active px-4 py-2 rounded-xl text-xs font-bold border transition-all bg-purple-600/15 border-purple-500/30 text-purple-400">Todas</button>
    <button data-status="paid" class="order-filter px-4 py-2 rounded-xl text-xs font-bold border transition-all border-slate-700 text-slate-400 hover:text-white hover:border-slate-600">Pagadas</button>
    <button data-status="shipped" class="order-filter px-4 py-2 rounded-xl text-xs font-bold border transition-all border-slate-700 text-slate-400 hover:text-white hover:border-slate-600">Enviadas</button>
    <button data-status="delivered" class="order-filter px-4 py-2 rounded-xl text-xs font-bold border transition-all border-slate-700 text-slate-400 hover:text-white hover:border-slate-600">Entregadas</button>
    <button data-status="cancelled" class="order-filter px-4 py-2 rounded-xl text-xs font-bold border transition-all border-slate-700 text-slate-400 hover:text-white hover:border-slate-600">Canceladas</button>
  </div>

  <!-- Table -->
  <div class="rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-800 text-left">
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">ID</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Wallet</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Total USDC</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Fecha</th>
            <th class="px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody id="orders-tbody" class="divide-y divide-slate-800/60">
          <tr><td colspan="6" class="px-5 py-8 text-center text-slate-600">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
    <div id="orders-pagination" class="flex items-center justify-between px-5 py-3 border-t border-slate-800">
      <p id="orders-count" class="text-xs text-slate-500"></p>
      <div class="flex gap-2">
        <button id="orders-prev" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-all disabled:opacity-30" disabled>? Anterior</button>
        <button id="orders-next" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-all disabled:opacity-30" disabled>Siguiente ?</button>
      </div>
    </div>
  </div>

  <script>
    let currentPage = 1;
    let currentStatus = '';
    const limit = 20;
    const statusLabels: Record<string, string> = { paid: 'Pagada', shipped: 'Enviada', delivered: 'Entregada', cancelled: 'Cancelada' };
    const statusColors: Record<string, string> = { paid: 'bg-emerald-500/15 text-emerald-400', shipped: 'bg-purple-500/15 text-purple-400', delivered: 'bg-violet-500/15 text-violet-400', cancelled: 'bg-red-500/15 text-red-400' };

    function shortAddr(s: string) { return s && s.length > 12 ? s.slice(0, 6) + '…' + s.slice(-4) : s; }
    function shortId(s: string) { return s && s.length > 18 ? s.slice(0, 18) + '…' : s; }

    async function loadOrders() {
      const params = new URLSearchParams({ page: String(currentPage), limit: String(limit) });
      if (currentStatus) params.set('status', currentStatus);

      try {
        const res = await fetch(`/api/admin/orders?${params}`);
        const data = await res.json();
        if (!data.ok) return;

        const tbody = document.getElementById('orders-tbody')!;
        if (!data.orders.length) {
          tbody.innerHTML = '<tr><td colspan="6" class="px-5 py-8 text-center text-slate-600">Sin resultados</td></tr>';
        } else {
          tbody.innerHTML = data.orders.map((o: any) => {
            const sc = statusColors[o.status] || 'bg-slate-500/15 text-slate-400';
            const sl = statusLabels[o.status] || o.status;
            return `
            <tr class="hover:bg-slate-800/30 transition-colors">
              <td class="px-5 py-3 font-mono text-xs text-white">${shortId(o.id)}</td>
              <td class="px-5 py-3 font-mono text-xs text-slate-400">${shortAddr(o.wallet_address)}</td>
              <td class="px-5 py-3 text-right font-bold text-emerald-400">$${Number(o.total_usdc).toFixed(2)}</td>
              <td class="px-5 py-3"><span class="px-2 py-0.5 rounded-lg text-[10px] font-bold ${sc}">${sl}</span></td>
              <td class="px-5 py-3 text-slate-500 text-xs">${new Date(o.created_at).toLocaleDateString('es-MX')}</td>
              <td class="px-5 py-3">
                <select data-order-id="${o.id}" class="order-status-select bg-slate-800 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white outline-none">
                  <option value="paid" ${o.status==='paid'?'selected':''}>Pagada</option>
                  <option value="shipped" ${o.status==='shipped'?'selected':''}>Enviada</option>
                  <option value="delivered" ${o.status==='delivered'?'selected':''}>Entregada</option>
                  <option value="cancelled" ${o.status==='cancelled'?'selected':''}>Cancelada</option>
                </select>
              </td>
            </tr>`;
          }).join('');

          tbody.querySelectorAll('.order-status-select').forEach((sel) => {
            sel.addEventListener('change', async (e) => {
              const orderId = (e.target as HTMLElement).dataset.orderId;
              const newStatus = (e.target as HTMLSelectElement).value;
              await fetch('/api/admin/orders', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: orderId, status: newStatus }),
              });
              loadOrders();
            });
          });
        }

        document.getElementById('orders-count')!.textContent = `${data.total} orden(es) total`;
        (document.getElementById('orders-prev') as HTMLButtonElement).disabled = currentPage <= 1;
        (document.getElementById('orders-next') as HTMLButtonElement).disabled = currentPage * limit >= data.total;
      } catch {
        document.getElementById('orders-tbody')!.innerHTML = '<tr><td colspan="6" class="px-5 py-8 text-center text-red-400">Error al cargar</td></tr>';
      }
    }

    document.querySelectorAll('.order-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.order-filter').forEach(b => {
          b.classList.remove('active', 'bg-purple-600/15', 'border-purple-500/30', 'text-purple-400');
          b.classList.add('border-slate-700', 'text-slate-400');
        });
        btn.classList.add('active', 'bg-purple-600/15', 'border-purple-500/30', 'text-purple-400');
        btn.classList.remove('border-slate-700', 'text-slate-400');
        currentStatus = (btn as HTMLElement).dataset.status || '';
        currentPage = 1;
        loadOrders();
      });
    });

    document.getElementById('orders-prev')?.addEventListener('click', () => { currentPage--; loadOrders(); });
    document.getElementById('orders-next')?.addEventListener('click', () => { currentPage++; loadOrders(); });

    loadOrders();
  </script>
</AdminLayout>
---
---

<div id="ai-agent-container">
  <!-- AI Chat Popover -->
  <div
    id="ai-agent-popover"
    class="hidden fixed top-20 left-3 right-3 sm:left-auto sm:right-4 w-auto sm:w-[380px] h-[min(540px,70dvh)] sm:h-[480px] rounded-3xl border border-slate-400/20 dark:border-white/10 bg-white/95 dark:bg-slate-900/95 shadow-2xl z-[9999] [backdrop-filter:blur(24px)] text-slate-900 dark:text-slate-100 [&:not(.hidden)]:flex flex-col overflow-hidden overscroll-contain"
  >
      <!-- Header -->
      <div class="relative flex items-center justify-between border-b border-slate-900/[0.06] dark:border-white/[0.08] px-4 py-3">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#3f043a] text-white shadow-sm shadow-[#3f043a]/30">
            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings:'FILL' 1">auto_awesome</span>
          </span>
          <div class="text-left">
            <h4 class="text-sm font-semibold leading-none tracking-tight text-slate-800 dark:text-slate-100">EdificARTE AI</h4>
            <span class="mt-1 flex items-center gap-1 text-[10px] font-medium text-slate-500 dark:text-slate-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> <span data-i18n="ai.online">Online</span>
            </span>
          </div>
        </div>
        <button id="ai-agent-close" class="flex h-9 w-9 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-900/5 hover:text-slate-600 dark:text-slate-500 dark:hover:bg-white/10 dark:hover:text-slate-200" aria-label="Close chat">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>

      <!-- Messages Area -->
      <div id="ai-agent-messages" class="flex-1 overflow-y-auto p-4 space-y-3 scrollbar-thin text-left">
        <!-- Initial Message -->
        <div class="flex items-start gap-2.5 max-w-[88%]">
          <span class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg border border-slate-200/70 bg-white/70 text-slate-500 backdrop-blur-sm dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 1">auto_awesome</span>
          </span>
          <div class="relative group break-words rounded-2xl rounded-tl-md border border-slate-200/60 bg-white/70 px-3.5 py-2.5 text-[13px] leading-relaxed text-slate-800 backdrop-blur-sm dark:border-white/10 dark:bg-white/5 dark:text-slate-100">
            <div class="pr-6" data-i18n-html="ai.greeting">
              ¡Hola! Soy tu guía de <strong class="text-[#3f043a] dark:text-[#e085b3]">EdificARTE</strong>. 🗺️<br/><br/>
              Puedo recomendarte lugares para visitar, contarte la historia de monumentos o ayudarte a planificar una ruta. ¿Qué te gustaría explorar hoy?
            </div>
            <button
              class="ai-speak-btn absolute top-2.5 right-2.5 p-0.5 text-slate-400 transition-colors hover:text-accent-600 dark:text-slate-500 dark:hover:text-accent-400"
              aria-label="Listen to response"
              title="Listen"
            >
              <span class="material-symbols-outlined text-[14px]">volume_up</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Input Area -->
      <div class="border-t border-slate-900/[0.06] dark:border-white/[0.08]">
        <form id="ai-agent-form" class="flex items-center gap-2 p-3">
          <button
            type="button"
            id="ai-mic-btn"
            class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border border-slate-200/70 bg-white/60 text-slate-400 backdrop-blur-sm transition-all hover:text-accent-600 active:scale-95 dark:border-white/10 dark:bg-white/5 dark:hover:text-accent-400"
            aria-label="Voice input"
            title="Voice input"
          >
            <span class="material-symbols-outlined text-[16px]">mic</span>
          </button>
          <input
            type="text"
            id="ai-agent-input"
            data-i18n-attr="placeholder|ai.placeholder"
            data-i18n-placeholder="ai.placeholder"
            placeholder="Ask about any place..."
            autocomplete="off"
            class="flex-1 min-w-0 rounded-xl border border-slate-200/70 bg-white/60 px-3.5 py-2.5 text-[16px] sm:text-[13px] text-slate-800 placeholder-slate-400 outline-none backdrop-blur-sm transition-all focus:border-accent-500/50 focus:bg-white/80 focus:ring-2 focus:ring-accent-500/20 dark:border-white/10 dark:bg-white/5 dark:text-slate-100 dark:placeholder-slate-500 dark:focus:bg-white/10"
          />
          <button
            type="submit"
            class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[#3f043a] text-white shadow-sm shadow-[#3f043a]/30 transition-all hover:bg-[#3f043a]/90 active:scale-95"
            aria-label="Send message"
          >
            <span class="material-symbols-outlined text-[16px]">arrow_upward</span>
          </button>
        </form>
      </div>
    </div>
</div>

<style>
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.35) transparent;
  }
  .scrollbar-thin::-webkit-scrollbar { width: 3px; }
  .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.35);
    border-radius: 2px;
  }
  :global(.dark) .scrollbar-thin {
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
  }
  :global(.dark) .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
  }

  /* Mobile bottom-sheet: safe-area aware offset + slide-up entrance.
     Scoped to .absolute so it never applies in the /mapa relative layout. */
  @media (max-width: 639px) {
    #ai-agent-popover.absolute {
      bottom: calc(4rem + env(safe-area-inset-bottom, 0px));
    }
    #ai-agent-popover:not(.hidden) {
      animation: ai-sheet-in 0.32s cubic-bezier(0.32, 0.72, 0, 1) both;
    }
  }
  @media (min-width: 640px) {
    #ai-agent-popover:not(.hidden) {
      animation: ai-pop-in 0.22s ease-out both;
    }
  }
  @keyframes ai-sheet-in {
    from { transform: translateY(24px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes ai-pop-in {
    from { transform: translateY(8px) scale(0.97); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
</style>

<script>
  import '../scripts/ai-agent.ts';
</script>

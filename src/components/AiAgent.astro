---
---

<div id="ai-agent-container">
  <!-- AI Chat Popover -->
  <div
    id="ai-agent-popover"
    class="hidden fixed top-20 left-3 right-3 sm:left-auto sm:right-4 w-auto sm:w-[400px] h-[min(580px,72dvh)] sm:h-[520px] rounded-3xl border border-slate-300/40 dark:border-white/15 bg-gradient-to-b from-white/98 to-slate-50/98 dark:from-slate-900/98 dark:to-slate-950/98 shadow-2xl shadow-slate-900/10 dark:shadow-black/40 z-[9999] [backdrop-filter:blur(32px)] text-slate-900 dark:text-slate-100 [&:not(.hidden)]:flex flex-col overflow-hidden overscroll-contain"
  >
      <!-- Header -->
      <div class="relative flex items-center justify-between border-b border-slate-200/70 dark:border-white/10 bg-white/60 dark:bg-slate-900/40 px-4 py-3.5 backdrop-blur-sm">
        <div class="flex items-center gap-3">
          <div class="relative">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-accent-500 to-accent-700 text-white shadow-lg shadow-accent-500/30 dark:shadow-accent-500/20 ring-2 ring-white/20 dark:ring-white/10">
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings:'FILL' 1">auto_awesome</span>
            </span>
            <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-slate-900 animate-pulse"></span>
          </div>
          <div class="text-left">
            <h4 class="text-sm font-bold leading-none tracking-tight text-slate-900 dark:text-white">Edi</h4>
            <span class="mt-1.5 flex items-center gap-1.5 text-[11px] font-medium text-slate-500 dark:text-slate-400">
              <span class="h-1 w-1 rounded-full bg-emerald-500"></span>
              <span data-i18n="ai.online">En línea</span>
            </span>
          </div>
        </div>
        <button id="ai-agent-close" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition-all hover:bg-slate-900/[0.04] hover:text-slate-600 active:scale-95 dark:text-slate-500 dark:hover:bg-white/[0.08] dark:hover:text-slate-300" aria-label="Close chat">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>

      <!-- Messages Area -->
      <div id="ai-agent-messages" class="flex-1 overflow-y-auto p-4 space-y-3.5 scrollbar-thin text-left">
        <!-- Initial Message -->
        <div class="flex items-start gap-2.5 max-w-[90%] animate-fade-in">
          <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-xl border border-accent-200/60 bg-gradient-to-br from-accent-50 to-accent-100/80 text-accent-600 shadow-sm dark:border-accent-900/40 dark:from-accent-950/40 dark:to-accent-900/30 dark:text-accent-300">
            <span class="material-symbols-outlined text-[15px]" style="font-variation-settings:'FILL' 1">auto_awesome</span>
          </span>
          <div class="relative group break-words rounded-2xl rounded-tl-md border border-slate-200/80 bg-white shadow-sm dark:border-white/[0.12] dark:bg-slate-800/60 px-4 py-3 text-[13.5px] leading-relaxed text-slate-800 dark:text-slate-100">
            <div class="pr-7" data-i18n-html="ai.greeting">
              ¡Hola! Soy tu guía de <strong class="text-accent-600 dark:text-accent-400">EdificARTE</strong>. 🏛️<br/><br/>Puedo recomendarte lugares para visitar, contarte sobre monumentos o ayudarte a planear una ruta. ¿Qué te gustaría explorar?
            </div>
            <button
              class="ai-speak-btn absolute top-3 right-3 p-1 rounded-lg text-slate-400 transition-all hover:bg-slate-100 hover:text-accent-600 active:scale-95 dark:text-slate-500 dark:hover:bg-slate-700/60 dark:hover:text-accent-400"
              aria-label="Listen to response"
              title="Escuchar"
            >
              <span class="material-symbols-outlined text-[15px]">volume_up</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Input Area -->
      <div class="border-t border-slate-200/70 dark:border-white/10 bg-white/80 dark:bg-slate-900/60 backdrop-blur-sm">
        <form id="ai-agent-form" class="flex items-center gap-2.5 p-3.5">
          <input
            type="text"
            id="ai-agent-input"
            data-i18n-attr="placeholder|ai.placeholder"
            data-i18n-placeholder="ai.placeholder"
            placeholder="Preguntá sobre cualquier lugar..."
            autocomplete="off"
            class="flex-1 min-w-0 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-[15px] sm:text-[14px] text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-accent-400 focus:ring-4 focus:ring-accent-500/10 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-accent-500 dark:focus:ring-accent-500/20"
          />
          <button
            type="submit"
            class="group flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg shadow-accent-500/25 transition-all hover:shadow-xl hover:shadow-accent-500/30 hover:scale-105 active:scale-95 dark:shadow-accent-500/20 dark:hover:shadow-accent-500/30"
            aria-label="Send message"
          >
            <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" style="font-variation-settings:'FILL' 1">arrow_upward</span>
          </button>
        </form>
      </div>
    </div>

  <!-- Airplane Animation Overlay -->
  <div
    id="flight-anim-overlay"
    class="pointer-events-none fixed inset-0 z-[10000] hidden overflow-hidden"
  >
    <div
      id="flight-plane"
      class="absolute bottom-[20%] left-[-160px] flex items-center gap-3 rounded-full border border-accent-400/50 bg-gradient-to-r from-accent-600/95 to-accent-700/95 px-6 py-3 text-white shadow-2xl shadow-accent-500/40 backdrop-blur-md ring-1 ring-white/20"
    >
      <span class="text-3xl animate-bounce">✈️</span>
      <span class="text-sm font-extrabold tracking-wide uppercase">
        ¡Planeando tu viaje!
      </span>
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }

  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.3) transparent;
  }
  .scrollbar-thin::-webkit-scrollbar { width: 4px; }
  .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 8px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.5);
  }
  :global(.dark) .scrollbar-thin {
    scrollbar-color: rgba(255, 255, 255, 0.12) transparent;
  }
  :global(.dark) .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.12);
  }
  :global(.dark) .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Mobile bottom-sheet: safe-area aware offset + slide-up entrance.
     Scoped to .absolute so it never applies in the /mapa relative layout. */
  @media (max-width: 639px) {
    #ai-agent-popover.absolute {
      bottom: calc(4rem + env(safe-area-inset-bottom, 0px));
    }
    #ai-agent-popover:not(.hidden) {
      animation: ai-sheet-in 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    }
  }
  @media (min-width: 640px) {
    #ai-agent-popover:not(.hidden) {
      animation: ai-pop-in 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
  }
  @keyframes ai-sheet-in {
    from {
      transform: translateY(32px) scale(0.96);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }
  @keyframes ai-pop-in {
    from {
      transform: translateY(12px) scale(0.92);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes flight-across {
    0% {
      transform: translate(0, 0) rotate(18deg) scale(0.65);
      opacity: 0;
    }
    12% {
      opacity: 1;
      transform: translate(20vw, -10vh) rotate(12deg) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(55vw, -32vh) rotate(4deg) scale(1.2);
    }
    88% {
      opacity: 1;
      transform: translate(90vw, -50vh) rotate(-8deg) scale(1);
    }
    100% {
      transform: translate(120vw, -65vh) rotate(-18deg) scale(0.65);
      opacity: 0;
    }
  }

  :global(.animate-flight) {
    animation: flight-across 3.8s cubic-bezier(0.33, 0.85, 0.56, 1) forwards !important;
  }
</style>

<script>
  import '../scripts/ai-agent.ts';
</script>

---
/**
 * Experiences grid - iOS 26 cards for guided tours.
 *
 * Read-only: receives tours data from the parent page. Renders a grid of
 * glassmorphic cards and a single reservation modal managed by the JS below.
 * Both locales (es/en) are inlined into the modal strings via existing
 * window.__TURIMAP_I18N__.
 */
import type { Tour } from '../../data/tours';
import { pickLocalized, type Locale } from '../../lib/i18n';

interface Props {
  tours: Tour[];
  locale?: Locale;
}

const { tours, locale = 'es' } = Astro.props;

// Pick locale-aware copy for each tour once on the server.
// pickLocalized(entity, field, locale) returns a string (defaults to es
// when no translation exists). See src/lib/i18n.ts.
const cards = tours.map((t) => ({
  id: t.id,
  title: pickLocalized(t, 'title', locale),
  subtitle: pickLocalized(t, 'subtitle', locale),
  duration: t.duration,
  pricePerPerson: t.pricePerPerson,
  currency: t.currency,
  image: t.image,
  description: pickLocalized(t, 'description', locale),
  meetingPoint: pickLocalized(t, 'meetingPoint', locale),
  guideName: t.guide.name,
  highlights: t.highlights,
  rating: 4.95,
  reviewCount: 124,
}));
---

<section id="experiencias" class="px-1 pb-12 pt-6">
  <header class="flex flex-col gap-1 pb-5">
    <h2
      class="ios-text-title1 text-slate-900 dark:text-white"
      data-i18n="reserva.title"
    >Experiencias</h2>
    <p
      class="ios-text-subhead text-slate-500 dark:text-slate-400"
      data-i18n="reserva.subtitle"
    >Reservá tours guiados por historiadores locales.</p>
  </header>

  <div id="experiencias-grid" class="ios-product-grid"></div>
</section>

<!-- Reservation modal -->
<div
  id="reserva-modal"
  class="fixed inset-0 z-[60] hidden items-end justify-center sm:items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reserva-modal-title"
>
  <div class="ios-backdrop absolute inset-0" data-reserva-dismiss></div>
  <div
    class="ios-modal relative mx-auto flex w-full flex-col overflow-hidden sm:max-w-lg"
    style="max-height: 92dvh;"
  >
    <button
      type="button"
      class="ios-stepper-btn absolute right-3 top-3 z-10"
      aria-label="Cerrar"
      data-reserva-dismiss
    >
      <span class="material-symbols-outlined text-[20px]">close</span>
    </button>

    <!-- Hero strip -->
    <div class="relative">
      <img
        id="reserva-hero"
        src=""
        alt=""
        class="aspect-[16/9] w-full object-cover"
        onerror="this.style.display='none'"
      />
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/60 to-transparent"></div>
      <div class="absolute inset-x-4 bottom-3 flex items-end justify-between gap-3 text-white">
        <div class="min-w-0">
          <p class="ios-text-caption2 opacity-90" data-i18n="reserva.modal.summary">Resumen</p>
          <h2 id="reserva-modal-title" class="ios-text-title3 truncate"></h2>
        </div>
        <p id="reserva-hero-price" class="ios-text-callout whitespace-nowrap font-bold"></p>
      </div>
    </div>

    <form id="reserva-form" class="flex flex-1 flex-col gap-4 overflow-y-auto px-5 py-5" novalidate>
      <input type="hidden" id="reserva-tour-id" />
      <input type="hidden" id="reserva-payment-method" value="usdc" />

      <!-- Summary box -->
      <div class="ios-card p-4">
        <div class="flex flex-col gap-2 text-[15px]">
          <div class="flex items-start justify-between gap-3">
            <span class="text-slate-500 dark:text-slate-400" data-i18n="reserva.modal.fields.date">Fecha</span>
            <span id="reserva-summary-date" class="font-semibold text-slate-900 dark:text-white">—</span>
          </div>
          <div class="flex items-start justify-between gap-3">
            <span class="text-slate-500 dark:text-slate-400" data-i18n="reserva.modal.fields.people">Personas</span>
            <span id="reserva-summary-people" class="font-semibold text-slate-900 dark:text-white">2</span>
          </div>
          <p id="reserva-meeting-point" class="ios-text-footnote text-slate-600 dark:text-slate-300"></p>
        </div>
      </div>

      <!-- Contact fields -->
      <div class="ios-field">
        <label for="reserva-name" class="ios-field-label" data-i18n="reserva.modal.fields.name">Nombre completo</label>
        <input id="reserva-name" name="name" type="text" required class="ios-input" autocomplete="name" />
      </div>
      <div class="ios-field">
        <label for="reserva-email" class="ios-field-label" data-i18n="reserva.modal.fields.email">Correo electrónico</label>
        <input id="reserva-email" name="email" type="email" required class="ios-input" autocomplete="email" />
      </div>
      <div class="ios-field">
        <label for="reserva-phone" class="ios-field-label" data-i18n="reserva.modal.fields.phone">Teléfono (opcional)</label>
        <input id="reserva-phone" name="phone" type="tel" class="ios-input" autocomplete="tel" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="ios-field">
          <label for="reserva-date" class="ios-field-label" data-i18n="reserva.modal.fields.date">Fecha</label>
          <input
            id="reserva-date"
            name="date"
            type="date"
            required
            class="ios-input"
            style="min-height: 44px;"
          />
        </div>
        <div class="ios-field">
          <label for="reserva-people" class="ios-field-label" data-i18n="reserva.modal.fields.people">Personas</label>
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="ios-stepper-btn"
              id="reserva-people-dec"
              aria-label="Restar"
            >
              <span class="material-symbols-outlined text-[16px]">remove</span>
            </button>
            <input
              id="reserva-people"
              name="people"
              type="number"
              min="1"
              max="20"
              value="2"
              class="ios-input flex-1 text-center"
            />
            <button
              type="button"
              class="ios-stepper-btn"
              id="reserva-people-inc"
              aria-label="Sumar"
            >
              <span class="material-symbols-outlined text-[16px]">add</span>
            </button>
          </div>
        </div>
      </div>
      <div class="ios-field">
        <label for="reserva-notes" class="ios-field-label" data-i18n="reserva.modal.fields.notes">Notas (opcional)</label>
        <textarea id="reserva-notes" name="notes" rows="2" class="ios-input" style="min-height: 64px; padding: 12px 14px;"></textarea>
      </div>

      <!-- Payment options -->
      <fieldset class="flex flex-col gap-3">
        <legend class="ios-text-caption2 mb-1 text-slate-500 dark:text-slate-400" data-i18n="reserva.modal.payment">Pago</legend>
        <label class="ios-card flex cursor-pointer items-start gap-3 p-4">
          <input type="radio" name="payment-radio" value="usdc" class="sr-only peer" checked />
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 peer-checked:bg-accent-500/30 peer-checked:text-accent-700 dark:bg-slate-800 dark:peer-checked:bg-accent-500/30">
            <span class="material-symbols-outlined text-[16px]">token</span>
          </span>
          <span class="flex flex-col gap-0.5">
            <span class="ios-text-headline text-slate-900 dark:text-white" data-i18n="reserva.modal.pay_usdc">USDC</span>
            <span class="ios-text-footnote text-slate-500 dark:text-slate-400" data-i18n="reserva.modal.pay_usdc_hint">Desde tu wallet.</span>
          </span>
        </label>
        <label class="ios-card flex cursor-pointer items-start gap-3 p-4">
          <input type="radio" name="payment-radio" value="arrival" class="sr-only peer" />
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 peer-checked:bg-accent-500/30 peer-checked:text-accent-700 dark:bg-slate-800 dark:peer-checked:bg-accent-500/30">
            <span class="material-symbols-outlined text-[16px]">storefront</span>
          </span>
          <span class="flex flex-col gap-0.5">
            <span class="ios-text-headline text-slate-900 dark:text-white" data-i18n="reserva.modal.pay_arrival">Pagar al llegar</span>
            <span class="ios-text-footnote text-slate-500 dark:text-slate-400" data-i18n="reserva.modal.pay_arrival_hint">Reservá ahora, pagás en persona.</span>
          </span>
        </label>
      </fieldset>

      <!-- Total -->
      <div class="ios-card p-4">
        <div class="flex items-baseline justify-between">
          <span class="ios-text-headline text-slate-900 dark:text-white" data-i18n="reserva.modal.total">Total</span>
          <span id="reserva-total" class="ios-text-title3 font-bold text-slate-900 dark:text-white">$0 MXN</span>
        </div>
        <p id="reserva-total-usdc" class="ios-text-footnote mt-1 text-right text-slate-500 dark:text-slate-400"></p>
      </div>

      <button
        type="submit"
        id="reserva-submit"
        class="ios-btn ios-btn-primary w-full"
        data-i18n="reserva.modal.submit"
      >Confirmar reserva</button>
    </form>

    <!-- Success view -->
    <div id="reserva-success" class="hidden flex-col items-center gap-4 px-5 py-12 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
        <span class="material-symbols-outlined text-[36px]">check_circle</span>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="ios-text-title3 text-slate-900 dark:text-white" data-i18n="reserva.modal.success_title">¡Reserva confirmada!</h3>
        <p id="reserva-success-subtitle" class="ios-text-footnote text-slate-500 dark:text-slate-400"></p>
      </div>
      <a
        id="reserva-tx-link"
        class="ios-btn ios-btn-secondary hidden w-full"
        target="_blank"
        rel="noopener noreferrer"
      >Ver en PolygonScan</a>
      <button type="button" id="reserva-close-success" class="ios-btn ios-btn-ghost w-full" data-i18n="reserva.modal.close">Cerrar</button>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    cards,
    mxnPerUsdc: 17,
  }}
>
  (function reservasApp() {
    if (!Array.isArray(cards) || cards.length === 0) return;

    const DICTS = (window.__EDIFICARTE_I18N__ || window.__TURIMAP_I18N__ || { es: {}, en: {} });
    function getDict() {
      // Mirrors detectLocale() in src/lib/i18n.ts (is:inline cannot import):
      // URL ?lang → localStorage → navigator.language, default 'es'.
      try {
        const q = new URL(window.location.href).searchParams.get('lang');
        if (q === 'es' || q === 'en') return DICTS[q];
      } catch { /* ignore */ }
      try {
        const s = localStorage.getItem('edificarte_locale') || localStorage.getItem('turimap_locale');
        if (s === 'en' || s === 'es') return DICTS[s];
      } catch { /* ignore */ }
      const n = (navigator && navigator.language) || '';
      return n.toLowerCase().startsWith('en') ? DICTS.en : DICTS.es;
    }
    const _dict = getDict();
    function resolve(dict, key) {
      const parts = key.split('.');
      let cur = dict;
      for (const p of parts) {
        if (cur && typeof cur === 'object' && p in cur) cur = cur[p];
        else return key;
      }
      return typeof cur === 'string' ? cur : key;
    }
    function tr(key, vars) {
      let s = resolve(_dict, key);
      if (!vars) return s;
      s = s.replace(/\{(\w+)\}/g, function (_, n) {
        return n in vars ? String(vars[n]) : '{' + n + '}';
      });
      return s;
    }
    function applyI18n() {
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (!key) return;
        el.innerHTML = tr(key);
      });
      document.querySelectorAll('[data-i18n-html]').forEach((el) => {
        const key = el.getAttribute('data-i18n-html');
        if (!key) return;
        el.innerHTML = tr(key);
      });
    }

    function escapeHtml(s) {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
    function fmtMxn(n) {
      return new Intl.NumberFormat('es-MX', {
        style: 'currency', currency: 'MXN', maximumFractionDigits: 0,
      }).format(n);
    }
    function fmtUsdc(n) {
      return new Intl.NumberFormat('es-MX', {
        style: 'currency', currency: 'USD',
        minimumFractionDigits: 2, maximumFractionDigits: 4,
      }).format(n);
    }
    function toUsdc(mxn) { return mxn / mxnPerUsdc; }
    function toUsdcRaw(amount) {
      return BigInt(Math.round(amount * 1_000_000)).toString();
    }

    const PEOPLE_KEY = 'edificarte_reserva_people';
    function peopleDefault() {
      try {
        const v = parseInt(localStorage.getItem(PEOPLE_KEY) || '0', 10);
        if (Number.isFinite(v) && v >= 1 && v <= 20) return v;
      } catch {}
      return 2;
    }

    function tomorrowISO() {
      const d = new Date();
      d.setDate(d.getDate() + 1);
      return d.toISOString().slice(0, 10);
    }

    // ----- Render grid -----
    const grid = document.getElementById('experiencias-grid');
    function renderGrid() {
      if (!grid) return;
      grid.innerHTML = '';
      cards.forEach((t) => {
        const card = document.createElement('article');
        card.className = 'ios-card flex cursor-pointer flex-col overflow-hidden';
        card.dataset.tourId = t.id;
        card.setAttribute('role', 'button');
        card.setAttribute('tabindex', '0');
        const highlight = (t.highlights && t.highlights[0]) || t.subtitle || '';
        card.innerHTML = `
          <div class="relative aspect-[4/3] overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img src="${escapeHtml(t.image)}" alt="${escapeHtml(t.title)}" loading="lazy"
              class="h-full w-full object-cover"
              onerror="this.style.display='none'" />
            <span class="ios-badge absolute left-3 top-3 bg-white/90 text-slate-900 backdrop-blur-md dark:bg-slate-900/85 dark:text-white">
              <span class="material-symbols-outlined text-[14px]">schedule</span>
              ${escapeHtml(t.duration)}
            </span>
          </div>
          <div class="flex flex-1 flex-col gap-2 p-4">
            <h3 class="ios-text-headline text-slate-900 dark:text-white line-clamp-2">${escapeHtml(t.title)}</h3>
            <p class="ios-text-footnote text-slate-500 dark:text-slate-400 line-clamp-2">${escapeHtml(highlight)}</p>
            <p class="ios-text-footnote text-slate-500 dark:text-slate-400 flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">location_on</span>
              <span class="truncate">${escapeHtml(t.meetingPoint)}</span>
            </p>
            <div class="mt-auto flex items-end justify-between gap-2 pt-2">
              <div class="flex flex-col">
                <span class="ios-text-caption2 text-slate-500 dark:text-slate-400">${tr('reserva.card.from')}</span>
                <span class="ios-text-callout font-bold text-slate-900 dark:text-white">${fmtMxn(t.pricePerPerson)}</span>
                <span class="ios-text-caption2 text-slate-500 dark:text-slate-400">${tr('reserva.card.per_person')}</span>
              </div>
              <div class="ios-btn ios-btn-primary !min-h-0 h-10 px-4 text-[13px]">
                <span class="material-symbols-outlined text-[16px]">event_available</span>
                ${tr('reserva.card.reserve')}
              </div>
            </div>
          </div>
        `;
        card.addEventListener('click', () => openModal(t.id));
        card.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            openModal(t.id);
          }
        });
        grid.appendChild(card);
      });
    }

    // ----- Modal -----
    const modalEl = document.getElementById('reserva-modal');
    const formEl = document.getElementById('reserva-form');
    const successEl = document.getElementById('reserva-success');
    const titleEl = document.getElementById('reserva-modal-title');
    const heroEl = document.getElementById('reserva-hero');
    const heroPriceEl = document.getElementById('reserva-hero-price');
    const dateInput = document.getElementById('reserva-date');
    const peopleInput = document.getElementById('reserva-people');
    const meetingEl = document.getElementById('reserva-meeting-point');
    const tourIdInput = document.getElementById('reserva-tour-id');
    const totalEl = document.getElementById('reserva-total');
    const totalUsdcEl = document.getElementById('reserva-total-usdc');
    const summaryDateEl = document.getElementById('reserva-summary-date');
    const summaryPeopleEl = document.getElementById('reserva-summary-people');
    const submitBtn = document.getElementById('reserva-submit');
    const txLinkEl = document.getElementById('reserva-tx-link');
    let currentTour = null;

    function show(el) {
      el.classList.remove('hidden');
      el.classList.add('flex');
      document.body.classList.add('modal-open');
    }
    function hide(el) {
      el.classList.add('hidden');
      el.classList.remove('flex');
      document.body.classList.remove('modal-open');
    }
    document.querySelectorAll('[data-reserva-dismiss]').forEach((b) => {
      b.addEventListener('click', () => hide(modalEl));
    });
    modalEl.addEventListener('click', (e) => {
      if (e.target === modalEl) hide(modalEl);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modalEl.classList.contains('hidden')) hide(modalEl);
    });

    function openModal(tourId) {
      const t = cards.find((c) => c.id === tourId);
      if (!t) return;
      currentTour = t;
      tourIdInput.value = t.id;
      titleEl.textContent = t.title;
      heroEl.src = t.image;
      heroEl.alt = t.title;
      heroPriceEl.textContent = fmtMxn(t.pricePerPerson);
      meetingEl.textContent = t.meetingPoint;
      formEl.reset();
      formEl.classList.remove('hidden');
      successEl.classList.add('hidden');
      successEl.classList.remove('flex');
      // Smart defaults: tomorrow's date, last-used people count (max 20)
      const defaults = tomorrowISO();
      dateInput.min = defaults;
      dateInput.value = defaults;
      const prevPeople = peopleDefault();
      peopleInput.value = String(prevPeople);
      updateSummary();
      show(modalEl);
      // Focus first field for keyboard users
      setTimeout(() => document.getElementById('reserva-name').focus(), 220);
    }

    function updateSummary() {
      const people = clamp(parseInt(peopleInput.value, 10) || 1, 1, 20);
      peopleInput.value = String(people);
      summaryPeopleEl.textContent = String(people);
      summaryDateEl.textContent = formatDateShort(dateInput.value);
      const totalMxn = currentTour ? currentTour.pricePerPerson * people : 0;
      totalEl.textContent = fmtMxn(totalMxn);
      const usd = toUsdc(totalMxn);
      totalUsdcEl.textContent = tr('reserva.modal.total_usdc_approx', { usdc: fmtUsdc(usd) });
    }
    function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
    function formatDateShort(iso) {
      if (!iso) return '—';
      try {
        return new Date(iso + 'T12:00:00').toLocaleDateString(undefined, {
          weekday: 'short', day: 'numeric', month: 'short',
        });
      } catch { return iso; }
    }

    dateInput.addEventListener('change', updateSummary);
    peopleInput.addEventListener('input', () => {
      let v = parseInt(peopleInput.value, 10);
      if (!Number.isFinite(v)) v = 1;
      peopleInput.value = String(clamp(v, 1, 20));
      try { localStorage.setItem(PEOPLE_KEY, String(parseInt(peopleInput.value, 10))); } catch {}
      updateSummary();
    });
    document.getElementById('reserva-people-dec').addEventListener('click', () => {
      peopleInput.value = String(clamp((parseInt(peopleInput.value, 10) || 1) - 1, 1, 20));
      peopleInput.dispatchEvent(new Event('input'));
    });
    document.getElementById('reserva-people-inc').addEventListener('click', () => {
      peopleInput.value = String(clamp((parseInt(peopleInput.value, 10) || 1) + 1, 1, 20));
      peopleInput.dispatchEvent(new Event('input'));
    });
    document.querySelectorAll('input[name="payment-radio"]').forEach((r) => {
      r.addEventListener('change', () => {
        document.getElementById('reserva-payment-method').value = r.value;
      });
    });

    function setError(input, msg) {
      input.classList.add('is-error');
      const id = input.id + '-err';
      let errEl = document.getElementById(id);
      if (!errEl) {
        errEl = document.createElement('p');
        errEl.id = id;
        errEl.className = 'ios-text-caption1 mt-1 text-rose-600 dark:text-rose-400';
        input.parentElement.appendChild(errEl);
      }
      errEl.textContent = msg;
    }
    function clearError(input) {
      input.classList.remove('is-error');
      const errEl = document.getElementById(input.id + '-err');
      if (errEl) errEl.remove();
    }

    formEl.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      [document.getElementById('reserva-name'), document.getElementById('reserva-email')].forEach(clearError);
      let valid = true;
      const name = document.getElementById('reserva-name').value.trim();
      const email = document.getElementById('reserva-email').value.trim();
      if (!name) { setError(document.getElementById('reserva-name'), tr('reserva.modal.errors.name_required')); valid = false; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError(document.getElementById('reserva-email'), tr('reserva.modal.errors.email_required'));
        valid = false;
      }
      const people = parseInt(peopleInput.value, 10);
      if (!Number.isFinite(people) || people < 1 || people > 20) {
        setError(peopleInput, tr('reserva.modal.errors.people_invalid'));
        valid = false;
      }
      const dateVal = dateInput.value;
      const tomorrow = tomorrowISO();
      if (!dateVal || dateVal < tomorrow) {
        setError(dateInput, tr('reserva.modal.errors.date_invalid'));
        valid = false;
      }
      if (!valid || !currentTour) return;

      const method = document.getElementById('reserva-payment-method').value;
      const totalMxn = currentTour.pricePerPerson * people;
      const totalUsdc = toUsdc(totalMxn);

      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = tr('reserva.modal.submitting');

      let payload = {
        tourId: currentTour.id,
        name,
        email,
        phone: document.getElementById('reserva-phone').value.trim(),
        date: dateVal,
        people,
        notes: document.getElementById('reserva-notes').value.trim(),
      };

      try {
        if (method === 'usdc') {
          const onchain = await import('../lib/onchain/client.ts');
          const wallet = new onchain.BrowserWalletProvider();
          const addr = await wallet.connect();
          const rawAmount = toUsdcRaw(totalUsdc);
          const paymentAddr =
            window.__EDIFICARTE_PAYMENT_ADDRESS__ ||
            window.__TURIMAP_PAYMENT_ADDRESS__ ||
            '0xD540067d763bc792b81f816a677bB25d7e6d4B0B';
          const txHash = await wallet.sendUsdcTransfer({ to: paymentAddr, rawAmount });
          payload = { ...payload, txHash, walletAddress: addr, totalUSDC: totalUsdc };
        }
        const res = await fetch('/api/reservar-tour', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) {
          throw new Error(json.error || tr('reserva.modal.errors.server'));
        }
        const submittedTxHash = (method === 'usdc') ? payload.txHash : null;
        showSuccess({
          method,
          txHash: submittedTxHash,
          reservation: {
            id: json.reservationId,
            tourId: currentTour.id,
            tourTitle: currentTour.title,
            name, email,
            phone: payload.phone,
            date: dateVal,
            people,
            notes: payload.notes,
            payment: method === 'usdc' ? 'usdc' : 'pending',
            txHash: submittedTxHash,
            totalMxn,
            totalUsdc,
            createdAt: new Date().toISOString(),
            status: method === 'usdc' ? 'paid' : 'pending',
          },
        });
      } catch (err) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
        alert((err && err.message) || tr('reserva.modal.errors.server'));
      }
    });

    function showSuccess({ method, txHash, reservation }) {
      formEl.classList.add('hidden');
      successEl.classList.remove('hidden');
      successEl.classList.add('flex');
      const subtitleEl = document.getElementById('reserva-success-subtitle');
      subtitleEl.textContent = method === 'usdc'
        ? tr('reserva.modal.success_subtitle_usdc')
        : tr('reserva.modal.success_subtitle_arrival');
      if (txHash) {
        txLinkEl.href = 'https://polygonscan.com/tx/' + txHash;
        txLinkEl.textContent = tr('tienda.checkout.view_polygonscan') || 'Ver en PolygonScan';
        txLinkEl.classList.remove('hidden');
      } else {
        txLinkEl.classList.add('hidden');
      }
      // Persist locally (same key /yo.astro already reads)
      try {
        const all = JSON.parse(localStorage.getItem('edificarte_reservations') || localStorage.getItem('turimap_reservations') || '[]');
        all.push(reservation);
        localStorage.setItem('edificarte_reservations', JSON.stringify(all));
        localStorage.setItem('turimap_reservations', JSON.stringify(all));
      } catch {}
      submitBtn.disabled = false;
      submitBtn.textContent = tr('reserva.modal.submit');
    }
    document.getElementById('reserva-close-success').addEventListener('click', () => hide(modalEl));

    // Expose for AI agent dispatch (legacy ai-reserve-tour event still works)
    const openReservaFn = (tourId) => {
      const t = cards.find((c) => c.id === tourId);
      if (t) openModal(t.id);
    };
    window.__EDIFICARTE_OPEN_RESERVA__ = openReservaFn;
    window.__TURIMAP_OPEN_RESERVA__ = openReservaFn;
    window.addEventListener('ai-reserve-tour', (e) => {
      const detail = (e && e.detail) || {};
      const id = detail.monumentId || detail.tourId;
      if (id) {
        const t = cards.find((c) => c.id === id);
        if (t) openModal(t.id);
      }
    });

    applyI18n();
    renderGrid();
  })();
</script>

